 <span data-kid=\"1-2-2-2-3-2-1-2-5-2\">\n                                        0.0 PX²\n                                    </span>\n                                </div>\n                                <div class=\"flex justify-between text-[#39FF14]\" data-kid=\"1-2-2-2-3-2-1-2-6\">\n                                    <span data-kid=\"1-2-2-2-3-2-1-2-6-1\">\n                                        CONFIDENCE\n                                    </span>\n                                    <span data-kid=\"1-2-2-2-3-2-1-2-6-2\">\n                                        0.0%\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"pipeline stages\">\n                            <h3 class=\"font-space text-[10px] tracking-widest text-white/40 uppercase\" data-kid=\"1-2-2-2-3-2-2-1\" data-name=\"pipeline header\">\n                                AI PIPELINE STAGES\n                            </h3>\n                            <div class=\"space-y-3\" data-kid=\"1-2-2-2-3-2-2-2\" data-name=\"pipeline steps list\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-3-2-2-2-1\" data-name=\"active pipeline step\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-3-2-2-2-1-1\" data-name=\"step info\">\n                                        <div class=\"w-1.5 h-1.5 bg-[#39FF14] rounded-full status-pulse\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-2-2-1-1-1\" data-name=\"pipeline pulse indicator\" data-reason=\"pulsed via GSAP\" id=\"pipeline-pulse\">\n                                        </div>\n                                        <span class=\"text-[10px] font-mono text-[#39FF14]\" data-kid=\"1-2-2-2-3-2-2-2-1-1-2\" data-name=\"step label\">\n                                            TYPE DETECTION\n                                        </span>\n                                    </div>\n                                    <i class=\"ti ti-circle-check text-[#39FF14] text-[10px]\" data-kid=\"1-2-2-2-3-2-2-2-1-2\" data-name=\"check mark icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex items-center gap-3 opacity-30\" data-kid=\"1-2-2-2-3-2-2-2-2\">\n                                    <div class=\"w-1.5 h-1.5 bg-white/20 rounded-full\" data-kid=\"1-2-2-2-3-2-2-2-2-1\">\n                                    </div>\n                                    <span class=\"text-[10px] font-mono\" data-kid=\"1-2-2-2-3-2-2-2-2-2\">\n                                        THERMAL CONV.\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 opacity-30\" data-kid=\"1-2-2-2-3-2-2-2-3\">\n                                    <div class=\"w-1.5 h-1.5 bg-white/20 rounded-full\" data-kid=\"1-2-2-2-3-2-2-2-3-1\">\n                                    </div>\n                                    <span class=\"text-[10px] font-mono\" data-kid=\"1-2-2-2-3-2-2-2-3-2\">\n                                        SEGMENTATION\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 opacity-30\" data-kid=\"1-2-2-2-3-2-2-2-4\">\n                                    <div class=\"w-1.5 h-1.5 bg-white/20 rounded-full\" data-kid=\"1-2-2-2-3-2-2-2-4-1\">\n                                    </div>\n                                    <span class=\"text-[10px] font-mono\" data-kid=\"1-2-2-2-3-2-2-2-4-2\">\n                                        INFERENCE\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-auto space-y-6\" data-kid=\"1-2-2-2-3-2-3\">\n                            <div data-kid=\"1-2-2-2-3-2-3-1\">\n                                <h3 class=\"font-space text-[10px] tracking-widest text-white/40 uppercase mb-4\" data-kid=\"1-2-2-2-3-2-3-1-1\">\n                                    THERMAL SCALE\n                                </h3>\n                                <div class=\"h-3 w-full bg-gradient-to-r from-[#000033] via-[#ffcc00] to-[#ff0000] border border-white/10 relative\" data-kid=\"1-2-2-2-3-2-3-1-2\">\n                                    <div class=\"absolute -top-5 left-0 text-[8px] font-mono text-white/40\" data-kid=\"1-2-2-2-3-2-3-1-2-1\">\n                                        0°C\n                                    </div>\n                                    <div class=\"absolute -top-5 right-0 text-[8px] font-mono text-white/40\" data-kid=\"1-2-2-2-3-2-3-1-2-2\">\n                                        100°C\n                                    </div>\n                                    <div class=\"absolute top-0 bottom-0 left-[15%] w-[1px] bg-white\" data-kid=\"1-2-2-2-3-2-3-1-2-3\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"text-[9px] font-mono text-white/40 space-y-1\" data-kid=\"1-2-2-2-3-2-3-2\">\n                                <div class=\"flex justify-between uppercase\" data-kid=\"1-2-2-2-3-2-3-2-1\">\n                                    <span data-kid=\"1-2-2-2-3-2-3-2-1-1\">\n                                        Sensor Noise\n                                    </span>\n                                    <span class=\"text-white\" data-kid=\"1-2-2-2-3-2-3-2-1-2\">\n                                        0.42%\n                                    </span>\n                                </div>\n                                <div class=\"flex justify-between uppercase\" data-kid=\"1-2-2-2-3-2-3-2-2\">\n                                    <span data-kid=\"1-2-2-2-3-2-3-2-2-1\">\n                                        Focal Length\n                                    </span>\n                                    <span class=\"text-white\" data-kid=\"1-2-2-2-3-2-3-2-2-2\">\n                                        35MM\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </main>\n    </div>\n    <!-- End Upper Flex -->\n    <!-- Full-Width Bottom Strip -->\n    <footer class=\"h-[72px] bg-[#0c0c0c] border-t border-white/5 flex flex-shrink-0 items-center px-8 justify-between z-50\" data-kid=\"1-3\" data-name=\"footer bar\">\n        <div class=\"flex items-center gap-12\" data-kid=\"1-3-1\" data-name=\"footer left status\">\n            <div class=\"flex flex-col\" data-kid=\"1-3-1-1\" data-name=\"runbook status\">\n                <span class=\"text-[9px] font-mono text-white/40 uppercase tracking-widest mb-1\" data-kid=\"1-3-1-1-1\" data-name=\"runbook title\">\n                    Active Command Runbook\n                </span>\n                <span class=\"font-space text-[11px] font-bold text-white/90 uppercase tracking-wider\" data-kid=\"1-3-1-1-2\" data-name=\"runbook name\">\n                    PRODUCTION_CV_PIPELINE_V4\n                </span>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-3-1-2\" data-name=\"pipeline connection status\">\n                <div class=\"flex gap-1 items-center\" data-kid=\"1-3-1-2-1\" data-name=\"status blinker indicator\">\n                    <div class=\"w-2 h-2 bg-[#39FF14] status-pulse\" data-kid=\"1-3-1-2-1-1\">\n                    </div>\n                    <div class=\"w-2 h-2 bg-[#39FF14] status-pulse\" data-kid=\"1-3-1-2-1-2\">\n                    </div>\n                    <div class=\"w-2 h-2 bg-[#39FF14] opacity-20\" data-kid=\"1-3-1-2-1-3\">\n                    </div>\n                    <div class=\"w-2 h-2 bg-[#39FF14] opacity-20\" data-kid=\"1-3-1-2-1-4\">\n                    </div>\n                    <div class=\"w-2 h-2 bg-[#39FF14] opacity-20\" data-kid=\"1-3-1-2-1-5\">\n                    </div>\n                </div>\n                <span class=\"text-[10px] font-mono text-[#39FF14] uppercase tracking-wider font-bold\" data-kid=\"1-3-1-2-2\">\n                    Pipeline Linked\n                </span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"1-3-2\" data-name=\"footer action buttons\">\n            <button class=\"flex items-center gap-2 px-6 py-2.5 bg-white/[0.03] border border-white/10 text-white/50 font-space text-[10px] tracking-widest cursor-not-allowed uppercase hover:bg-white/5\" data-kid=\"1-3-2-1\" data-name=\"generate report button\" disabled=\"\">\n                <i class=\"ti ti-file-text\" data-kid=\"1-3-2-1-1\" data-name=\"report icon\">\n                </i>\n                Generate Report\n            </button>\n            <button class=\"flex items-center gap-2 px-6 py-2.5 bg-white/[0.03] border border-white/10 text-white/50 font-space text-[10px] tracking-widest cursor-not-allowed uppercase hover:bg-white/5\" data-kid=\"1-3-2-2\" data-name=\"export JSON button\" disabled=\"\">\n                <i class=\"ti ti-code\" data-kid=\"1-3-2-2-1\" data-name=\"export icon\">\n                </i>\n                Export JSON\n            </button>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    function updateClock() {\n    const now = new Date();\n    const h = String(now.getUTCHours()).padStart(2, '0');\n    const m = String(now.getUTCMinutes()).padStart(2, '0');\n    const s = String(now.getUTCSeconds()).padStart(2, '0');\n    const ms = String(now.getUTCMilliseconds()).padStart(3, '0').slice(0, 2);\n    const clockEl = document.getElementById('utc-clock');\n    if(clockEl) clockEl.textContent = `${h}:${m}:${s}.${ms}`;\n  }\n  setInterval(updateClock, 100);\n\n  window.addEventListener('DOMContentLoaded', () => {\n    // Reticle Animations\n    gsap.to(\"#reticle-outer\", { rotation: 360, duration: 40, repeat: -1, ease: \"none\" });\n    gsap.to(\"#reticle-mid\", { rotation: 180, duration: 60, repeat: -1, ease: \"none\" });\n    gsap.to(\"#reticle-inner\", { rotation: -360, duration: 80, repeat: -1, ease: \"none\" });\n\n    // HUD Text Pulses\n    gsap.to(\"#scanning-text\", { opacity: 0.2, duration: 1.5, repeat: -1, yoyo: true, ease: \"sine.inOut\" });\n    gsap.to(\"#live-indicator\", { opacity: 0.3, duration: 0.8, repeat: -1, yoyo: true, ease: \"sine.inOut\" });\n\n    // Scanline vertical sweep\n    gsap.to(\"#scanline\", { top: \"100%\", duration: 5, repeat: -1, ease: \"none\" });\n\n    // Queue entrance\n    gsap.from(\".queue-item\", { x: -30, opacity: 0, duration: 0.7, stagger: 0.15, ease: \"power3.out\", delay: 0.3 });\n\n    // Pipeline pulse\n    gsap.to(\"#pipeline-pulse\", { scale: 1.4, opacity: 0.6, duration: 1, repeat: -1, yoyo: true, ease: \"power2.inOut\" });\n\n    // Toast from bottom\n    gsap.from(\"#toast-container\", { y: 40, opacity: 0, duration: 0.8, delay: 1, ease: \"back.out(1.5)\" });\n\n    // Active progress bar simulation\n    gsap.to(\"#progress-bar-1\", { width: \"68%\", duration: 8, repeat: -1, yoyo: true, ease: \"power1.inOut\" });\n  });\n</script>\n",

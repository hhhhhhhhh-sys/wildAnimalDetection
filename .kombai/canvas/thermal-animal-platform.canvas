 </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-7-2\">\n                                    +50\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-7-3\">\n                                    0\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-7-4\">\n                                    -50\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-7-5\">\n                                    -100\n                                </span>\n                            </div>\n                            <div class=\"absolute right-[-60px] top-1/2 -translate-y-1/2 h-[160px] w-6 border-r border-[#39FF14]/20 flex flex-col justify-between items-end py-2 text-[8px] font-mono text-white/40\" data-kid=\"1-2-2-2-2-4-7-8\" data-name=\"right scale ruler\">\n                                <span data-kid=\"1-2-2-2-2-4-7-8-1\">\n                                    100%\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-8-2\">\n                                    75%\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-8-3\">\n                                    50%\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-8-4\">\n                                    25%\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-4-7-8-5\">\n                                    0%\n                                </span>\n                            </div>\n                        </div>\n                        <!-- Toast Alert -->\n                        <div class=\"absolute bottom-24 right-12 z-30 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-4-8\" data-name=\"toast alert container\" data-reaso
      },
      "html": "<div class=\"bg-[#1B1B1B] text-[#FFD700] font-['JetBrains_Mono'] min-h-screen selection:bg-[#FFD700] selection:text-black p-4 md:p-8 overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=JetBrains+Mono:wght@400;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .bento-cell, .bento-header {\n      background-color: #2A3439;\n      border: 2px solid #4a4a5a;\n      box-shadow: 6px 6px 0px #000;\n      position: relative;\n    }\n\n    .canvas-border {\n      border: 4px solid #FFD700;\n      box-shadow: 12px 12px 0px #000;\n    }\n\n    .brutal-btn {\n      box-shadow: 4px 4px 0px #000;\n    }\n    \n    .brutal-btn:active {\n      transform: translate(2px, 2px);\n      box-shadow: 2px 2px 0px #000;\n    }\n\n    .thermal-gradient {\n      background: radial-gradient(circle at center, #FF2400 0%, #FFA500 20%, #4B0082 50%, #1B1B1B 80%);\n      background-size: 200% 200%;\n    }\n    </style>\n    <div class=\"max-w-[1280px] mx-auto space-y-8\" data-kid=\"1-1\" data-name=\"main content wrapper\">\n        <!-- Utility Bar -->\n        <header class=\"bento-header p-5 border-b-4 border-[#FFD700] flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"1-1-1\" data-name=\"utility header bar\">\n            <div class=\"flex items-center gap-8\" data-kid=\"1-1-1-1\" data-name=\"logo and workspace info container\">\n                <div data-kid=\"1-1-1-1-1\" data-name=\"branding and info container\">\n                    <h1 class=\"font-['Archivo'] text-2xl md:text-3xl font-black uppercase tracking-tighter leading-none text-white\" data-kid=\"1-1-1-1-1-1\" data-name=\"hero headline text\">\n                        THERMAL ANIMAL\n                        <span class=\"text-[#FFD700]\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"headline control suffix\">\n                            // CONTROL\n                        </span>\n                    </h1>\n                    <div class=\"flex items-center gap-2 mt-1.5\" data-kid=\"1-1-1-1-1-2\" data-name=\"workspace badge container\">\n                        <span class=\"bg-[#FFD700] text-black px-1.5 py-0.5 text-[10px] font-black uppercase\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"workspace tag\">\n                            Workspace\n                        </span>\n                        <span class=\"text-[11px] text-[#FFD700]/90 font-bold uppercase tracking-wider\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"workspace lab info text\">\n                            Field lab / Dataset intake\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <nav class=\"flex flex-wrap items-center justify-center gap-3\" data-kid=\"1-1-1-2\" data-name=\"navigation link container\">\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase text-[#FFD700]/80 hover:text-[#FFD700]\" data-kid=\"1-1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                    Dashboard\n                </a>\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase bg-[#FFD700] text-black border-2 border-[#FFD700] relative overflow-hidden group\" data-kid=\"1-1-1-2-2\" data-name=\"upload navigation button\" href=\"#\">\n                    <span class=\"relative z-10\" data-kid=\"1-1-1-2-2-1\" data-name=\"upload button label\">\n                        Upload\n                    </span>\n                    <div class=\"absolute inset-0 bg-white/30 -translate-x-full group-hover:translate-x-0 transition-transform duration-200\" data-kid=\"1-1-1-2-2-2\" data-name=\"button hover background overlay\">\n                    </div>\n                </a>\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase text-[#FFD700]/80 hover:text-[#FFD700]\" data-kid=\"1-1-1-2-3\" data-name=\"results navigation link\" href=\"#\">\n                    Results\n                </a>\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase text-[#FFD700]/80 hover:text-[#FFD700]\" data-kid=\"1-1-1-2-4\" data-name=\"analytics navigation link\" href=\"#\">\n                    Analytics\n                </a>\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase text-[#FFD700]/80 hover:text-[#FFD700]\" data-kid=\"1-1-1-2-5\" data-name=\"reports navigation link\" href=\"#\">\n                    Reports\n                </a>\n                <a class=\"px-3 py-1.5 text-xs font-black uppercase text-[#FFD700]/80 hover:text-[#FFD700]\" data-kid=\"1-1-1-2-6\" data-name=\"settings navigation link\" href=\"#\">\n                    Settings\n                </a>\n            </nav>\n            <div class=\"hidden lg:flex items-center gap-3 pl-6 border-l-2 border-[#4a4a5a]\" data-kid=\"1-1-1-3\" data-name=\"system status container\">\n                <div class=\"status-pulse w-2.5 h-2.5 rounded-full bg-[#FFD700]\" data-dynamic=\"true\" data-kid=\"1-1-1-3-1\" data-name=\"system status pulse indicator\" data-reason=\"scaled and faded by script\">\n                </div>\n                <span class=\"text-[10px] font-black tracking-widest uppercase\" data-kid=\"1-1-1-3-2\" data-name=\"system status description text\">\n                    Local Inference Ready\n                </span>\n            </div>\n        </header>\n        <!-- Main Workspace Bento Grid -->\n        <main class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\" data-kid=\"1-1-2\" data-name=\"main workspace bento grid\">\n            <!-- Upload Tile (Top Left) -->\n            <section class=\"bento-cell p-6 flex flex-col justify-between h-[500px] lg:h-auto lg:row-span-2\" data-kid=\"1-1-2-1\" data-name=\"upload intake section\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"intake section header and zone\">\n                    <h2 class=\"font-['Archivo'] text-xl font-black uppercase text-white mb-6 flex items-center gap-2\" data-kid=\"1-1-2-1-1-1\" data-name=\"intake pipeline section title\">\n                        <i class=\"ti ti-folder-plus text-[#FFD700]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"folder icon\">\n                        </i>\n                        Intake Pipeline\n                    </h2>\n                    <div class=\"group cursor-pointer border-4 border-dashed border-[#4a4a5a] hover:border-[#FFD700] transition-colors duration-300 h-64 flex flex-col items-center justify-center text-center p-6 gap-4 bg-black/20\" data-kid=\"1-1-2-1-1-2\" data-name=\"file drop zone area\">\n                        <i class=\"ti ti-cloud-upload text-7xl text-[#4a4a5a] group-hover:text-[#FFD700] group-hover:scale-110 transition-all duration-300\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"upload cloud icon\">\n                        </i>\n                        <div class=\"space-y-1\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"drop zone instruction text container\">\n                            <p class=\"font-black text-sm uppercase leading-tight\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"drop instruction text\">\n                                Drop dataset folder\n                                <br data-kid=\"1-1-2-1-1-2-2-1-1\" data-name=\"instruction line break\"/>\n                                or images\n                            </p>\n                            <p class=\"text-[10px] text-[#FF2400] font-bold uppercase\" data-kid=\"1-1-2-1-1-2-2-2\" data-name=\"file status text\">\n                                No files attached\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-6 mt-8\" data-kid=\"1-1-2-1-2\" data-name=\"supported modes and buttons container\">\n                    <div class=\"space-y-2\" data-kid=\"1-1-2-1-2-1\" data-name=\"supported modes section\">\n                        <p class=\"text-[10px] uppercase font-bold opacity-50 tracking-widest\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"supported modes label\">\n                            Supported Modes\n                        </p>\n                        <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"modes grid container\">\n                            <span class=\"px-2 py-1 bg-black/40 text-[9px] border border-white/10 uppercase font-bold text-center\" data-kid=\"1-1-2-1-2-1-2-1\" data-name=\"day mode badge\">\n                                Day\n                            </span>\n                            <span class=\"px-2 py-1 bg-black/40 text-[9px] border border-white/10 uppercase font-bold text-center\" data-kid=\"1-1-2-1-2-1-2-2\" data-name=\"night mode badge\">\n                                Night\n                            </span>\n                            <span class=\"px-2 py-1 bg-black/40 text-[9px] border border-[#FFD700] uppercase font-bold text-center text-[#FFD700]\" data-kid=\"1-1-2-1-2-1-2-3\" data-name=\"thermal mode badge\">\n                                Thermal\n                            </span>\n                            <span class=\"px-2 py-1 bg-black/40 text-[9px] border border-white/10 uppercase font-bold text-center\" data-kid=\"1-1-2-1-2-1-2-4\" data-name=\"infrared mode badge\">\n                                Infrared\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-1 gap-3\" data-kid=\"1-1-2-1-2-2\" data-name=\"action button container\">\n                        <button class=\"brutal-btn w-full bg-[#FFD700] text-black font-black uppercase text-xs py-4 flex items-center justify-center gap-2\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"browse folder button\">\n                            <i class=\"ti ti-folder text-lg\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"browse folder icon\">\n                            </i>\n                            Browse folder\n                        </button>\n                        <button class=\"brutal-btn w-full bg-black text-[#FFD700] border-2 border-[#FFD700] font-black uppercase text-xs py-4 flex items-center justify-center gap-2\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"open webcam button\">\n                            <i class=\"ti ti-video text-lg\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"open webcam icon\">\n                            </i>\n                            Open webcam\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <!-- Inference Canvas (Center Large) -->\n            <section class=\"bento-cell lg:col-span-2 lg:row-span-2 canvas-border flex flex-col bg-[#1B1B1B] overflow-hidden min-h-[500px]\" data-kid=\"1-1-2-2\" data-name=\"inference canvas section\">\n                <!-- Canvas Tabs -->\n                <div class=\"bg-[#FFD700] text-black flex flex-col sm:flex-row justify-between items-stretch font-black text-[10px] uppercase border-b-4 border-black\" data-kid=\"1-1-2-2-1\" data-name=\"canvas tab bar\">\n                    <div class=\"px-4 py-3 bg-black text-[#FFD700] flex items-center border-r-4 border-black tracking-[0.15em] font-black\" data-kid=\"1-1-2-2-1-1\" data-name=\"viewport indicator\">\n                        <i class=\"ti ti-scan text-sm mr-2\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"scan icon\">\n                        </i>\n                        THERMAL VIEWPORT / DATASET_SLOT_01\n                    </div>\n                    <div class=\"flex flex-1\" data-kid=\"1-1-2-2-1-2\" data-name=\"canvas navigation tabs\">\n                        <button class=\"flex-1 px-4 py-3 hover:bg-black/10 transition-colors border-r border-black/10\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"raw tab button\">\n                            RAW\n                        </button>\n                        <button class=\"flex-1 px-4 py-3 bg-black text-[#FFD700] relative\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"thermal tab button\">\n                            THERMAL\n                            <div class=\"absolute bottom-0 left-0 right-0 h-1 bg-[#FF2400]\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"tab active indicator bar\">\n                            </div>\n                        </button>\n                        <button class=\"flex-1 px-4 py-3 hover:bg-black/10 transition-colors border-r border-black/10\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"segment tab button\">\n                            SEGMENT\n                        </button>\n                        <button class=\"flex-1 px-4 py-3 hover:bg-black/10 transition-colors\" data-kid=\"1-1-2-2-1-2-4\" data-name=\"data tab button\">\n                            DATA\n                        </button>\n                    </div>\n                </div>\n                <!-- Viewport Area -->\n                <div class=\"flex-1 relative flex items-center justify-center p-8\" data-kid=\"1-1-2-2-2\" data-name=\"viewport display area\">\n                    <!-- Thermal Grid Shimmer -->\n                    <div class=\"absolute inset-0 thermal-shimmer opacity-30 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1\" data-name=\"shimmer grid overlay\" data-reason=\"background position moved by script\" style=\"background-image: radial-gradient(#FFD700 1.5px, transparent 1.5px); background-size: 32px 32px;\">\n                    </div>\n                    <div class=\"absolute inset-0 thermal-gradient opacity-10 animate-[pulse_8s_infinite]\" data-kid=\"1-1-2-2-2-2\" data-name=\"thermal gradient background\">\n                    </div>\n                    <!-- Corner Brackets -->\n                    <div class=\"absolute top-8 left-8 w-16 h-16 border-t-8 border-l-8 border-[#FFD700]\" data-kid=\"1-1-2-2-2-3\" data-name=\"top-left corner bracket\">\n                    </div>\n                    <div class=\"absolute top-8 right-8 w-16 h-16 border-t-8 border-r-8 border-[#FFD700]\" data-kid=\"1-1-2-2-2-4\" data-name=\"top-right corner bracket\">\n                    </div>\n                    <div class=\"absolute bottom-8 left-8 w-16 h-16 border-b-8 border-l-8 border-[#FFD700]\" data-kid=\"1-1-2-2-2-5\" data-name=\"bottom-left corner bracket\">\n                    </div>\n                    <div class=\"absolute bottom-8 right-8 w-16 h-16 border-b-8 border-r-8 border-[#FFD700]\" data-kid=\"1-1-2-2-2-6\" data-name=\"bottom-right corner bracket\">\n                    </div>\n                    <!-- Empty State Content -->\n                    <div class=\"text-center space-y-6 relative z-10 max-w-sm\" data-kid=\"1-1-2-2-2-7\" data-name=\"empty state content container\">\n                        <div class=\"font-['Archivo'] text-8xl font-black text-[#FFD700]/20 tracking-tighter uppercase select-none leading-none scale-y-125\" data-kid=\"1-1-2-2-2-7-1\" data-name=\"no-data placeholder text\">\n                            NO_DATA\n                        </div>\n                        <div class=\"space-y-2\" data-kid=\"1-1-2-2-2-7-2\" data-name=\"instruction text container\">\n                            <h3 class=\"font-['Archivo'] text-3xl font-black uppercase text-white tracking-tighter leading-none\" data-kid=\"1-1-2-2-2-7-2-1\" data-name=\"instruction heading\">\n                                UPLOAD A FRAME TO BEGIN\n                            </h3>\n                            <p class=\"text-[11px] text-[#FFD700] uppercase tracking-[0.3em] font-black opacity-80\" data-kid=\"1-1-2-2-2-7-2-2\" data-name=\"instruction subtext\">\n                                Awaiting telemetry from neural engine\n                            </p>\n                        </div>\n                        <div class=\"flex justify-center gap-1.5\" data-kid=\"1-1-2-2-2-7-3\" data-name=\"loading animation dots\">\n                            <div class=\"w-1 h-1 bg-[#FFD700] animate-bounce\" data-kid=\"1-1-2-2-2-7-3-1\" data-name=\"loading dot one\" style=\"animation-delay: 0s\">\n                            </div>\n                            <div class=\"w-1 h-1 bg-[#FFD700] animate-bounce\" data-kid=\"1-1-2-2-2-7-3-2\" data-name=\"loading dot two\" style=\"animation-delay: 0.2s\">\n                            </div>\n                            <div class=\"w-1 h-1 bg-[#FFD700] animate-bounce\" data-kid=\"1-1-2-2-2-7-3-3\" data-name=\"loading dot three\" style=\"animation-delay: 0.4s\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Pipeline Log (Top Right) -->\n            <section class=\"bento-cell bg-black p-4 font-['JetBrains_Mono'] text-[11px] flex flex-col h-[240px]\" data-kid=\"1-1-2-3\" data-name=\"pipeline log container\">\n                <div class=\"flex items-center justify-between mb-4 pb-2 border-b border-white/10\" data-kid=\"1-1-2-3-1\" data-name=\"log header\">\n                    <div class=\"flex gap-1.5\" data-kid=\"1-1-2-3-1-1\" data-name=\"log traffic lights container\">\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-[#FF2400]\" data-kid=\"1-1-2-3-1-1-1\" data-name=\"red light\">\n                        </div>\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-[#FFD700]\" data-kid=\"1-1-2-3-1-1-2\" data-name=\"yellow light\">\n                        </div>\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-green-500\" data-kid=\"1-1-2-3-1-1-3\" data-name=\"green light\">\n                        </div>\n                    </div>\n                    <span class=\"text-[9px] font-black uppercase tracking-widest text-[#FFD700]/50\" data-kid=\"1-1-2-3-1-2\" data-name=\"pipeline log label\">\n                        Pipeline Log\n                    </span>\n                </div>\n                <div class=\"flex-1 space-y-2 overflow-hidden overflow-y-auto pr-2 custom-scrollbar\" data-kid=\"1-1-2-3-2\" data-name=\"log entries container\">\n                    <p class=\"text-[#FFD700] font-black tracking-tight text-sm\" data-kid=\"1-1-2-3-2-1\" data-name=\"log entry one\">\n                        > Input classifier waiting...\n                    </p>\n                    <p class=\"text-white/80\" data-kid=\"1-1-2-3-2-2\" data-name=\"log entry two\">\n                        > Thermal converter armed\n                    </p>\n                    <p class=\"text-white/80\" data-kid=\"1-1-2-3-2-3\" data-name=\"log entry three\">\n                        > YOLO + SAM + EfficientNet ready\n                    </p>\n                    <p class=\"text-white/70\" data-kid=\"1-1-2-3-2-4\" data-name=\"log entry four\">\n                        > Report generator idle\n                    </p>\n                    <p class=\"text-green-500 font-bold flex items-center gap-1\" data-kid=\"1-1-2-3-2-5\" data-name=\"log entry five\">\n                        > System listening\n                        <span class=\"terminal-cursor w-1.5 h-3.5 bg-[#FFD700]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-5-1\" data-name=\"terminal blinking cursor\" data-reason=\"opacity toggled by script\">\n                        </span>\n                    </p>\n                    <p class=\"text-[#FFD700]/60 text-[9px] mt-4 uppercase font-black tracking-widest\" data-kid=\"1-1-2-3-2-6\" data-name=\"neural temp log entry\">\n                        -- Neural temp: 42.1°C --\n                    </p>\n                </div>\n            </section>\n            <!-- Widgets (Mid Right) -->\n            <section class=\"space-y-6\" data-kid=\"1-1-2-4\" data-name=\"widgets column container\">\n                <!-- Classification -->\n                <div class=\"bento-cell p-5 shadow-[4px_4px_0_#000] border-l-4 border-l-[#FFD700]\" data-kid=\"1-1-2-4-1\" data-name=\"classification widget\">\n                    <h4 class=\"text-[9px] uppercase font-black text-[#FFD700]/80 mb-1 tracking-[0.2em]\" data-kid=\"1-1-2-4-1-1\" data-name=\"classification label\">\n                        Live classification\n                    </h4>\n                    <div class=\"font-['Archivo'] text-4xl font-black uppercase text-white mb-2 leading-tight tracking-tighter\" data-kid=\"1-1-2-4-1-2\" data-name=\"classification output text\">\n                        Unknown\n                    </div>\n                    <div class=\"flex items-end justify-between border-t border-white/10 pt-2\" data-kid=\"1-1-2-4-1-3\" data-name=\"confidence score container\">\n                        <span class=\"text-[10px] opacity-40 uppercase font-bold\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"confidence label\">\n                            Confidence\n                        </span>\n                        <span class=\"text-2xl font-black text-[#FFD700] leading-none\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"confidence percentage value\">\n                            -- %\n                        </span>\n                    </div>\n                </div>\n                <!-- Thermal Proportion Bar -->\n                <div class=\"bento-cell p-5 shadow-[4px_4px_0_#000] space-y-4\" data-kid=\"1-1-2-4-2\" data-name=\"thermal balance widget\">\n                    <h4 class=\"text-[9px] uppercase font-black text-[#FFD700] tracking-widest\" data-kid=\"1-1-2-4-2-1\" data-name=\"thermal balance label\">\n                        Thermal Balance\n                    </h4>\n                    <div class=\"h-8 w-full flex border-2 border-black overflow-hidden bg-black\" data-kid=\"1-1-2-4-2-2\" data-name=\"thermal balance bar container\">\n                        <div class=\"h-full bg-blue-900 w-[70%] border-r border-black/20\" data-kid=\"1-1-2-4-2-2-1\" data-name=\"cold bar segment\">\n                        </div>\n                        <div class=\"h-full bg-indigo-900 w-[15%] border-r border-black/20\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"warm bar segment\">\n                        </div>\n                        <div class=\"h-full bg-orange-700 w-[10%] border-r border-black/20\" data-kid=\"1-1-2-4-2-2-3\" data-name=\"hot bar segment\">\n                        </div>\n                        <div class=\"h-full bg-[#FF2400] w-[5%] animate-pulse\" data-kid=\"1-1-2-4-2-2-4\" data-name=\"hotspot bar segment\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-4 text-[9px] uppercase font-black gap-1 text-center\" data-kid=\"1-1-2-4-2-3\" data-name=\"balance legend container\">\n                        <span class=\"text-blue-400/80\" data-kid=\"1-1-2-4-2-3-1\" data-name=\"cold legend\">\n                            Cold\n                        </span>\n                        <span class=\"text-indigo-400/80\" data-kid=\"1-1-2-4-2-3-2\" data-name=\"warm legend\">\n                            Warm\n                        </span>\n                        <span class=\"text-orange-400/80\" data-kid=\"1-1-2-4-2-3-3\" data-name=\"hot legend\">\n                            Hot\n                        </span>\n                        <span class=\"text-[#FF2400]\" data-kid=\"1-1-2-4-2-3-4\" data-name=\"hotspot legend\">\n                            Hotspot\n                        </span>\n                    </div>\n                </div>\n                <!-- Action Widgets -->\n                <div class=\"bento-cell p-5 shadow-[4px_4px_0_#000] grid grid-cols-1 gap-2\" data-kid=\"1-1-2-4-3\" data-name=\"action widget container\">\n                    <button class=\"brutal-btn w-full bg-[#1B1B1B] text-white/20 border border-white/10 font-black uppercase text-[10px] py-3 cursor-not-allowed flex items-center justify-between px-4\" data-kid=\"1-1-2-4-3-1\" data-name=\"generate pdf button\" disabled=\"\">\n                        Generate PDF\n                        <i class=\"ti ti-lock\" data-kid=\"1-1-2-4-3-1-1\" data-name=\"lock icon\">\n                        </i>\n                    </button>\n                    <button class=\"brutal-btn w-full bg-[#1B1B1B] text-white/20 border border-white/10 font-black uppercase text-[10px] py-3 cursor-not-allowed flex items-center justify-between px-4\" data-kid=\"1-1-2-4-3-2\" data-name=\"export csv button\" disabled=\"\">\n                        Export CSV\n                        <i class=\"ti ti-lock\" data-kid=\"1-1-2-4-3-2-1\" data-name=\"lock icon\">\n                        </i>\n                    </button>\n                </div>\n            </section>\n            <!-- History Table (Bottom Full-Width) -->\n            <section class=\"bento-cell lg:col-span-4 overflow-hidden shadow-[8px_8px_0_#000] mt-4\" data-kid=\"1-1-2-5\" data-name=\"history table section\">\n                <div class=\"bg-black/40 p-6 border-b-2 border-[#4a4a5a] flex justify-between items-center\" data-kid=\"1-1-2-5-1\" data-name=\"history table header\">\n                    <h3 class=\"font-['Archivo'] font-black uppercase text-lg tracking-tight text-white flex items-center gap-2\" data-kid=\"1-1-2-5-1-1\" data-name=\"history table title\">\n                        <i class=\"ti ti-activity text-[#FFD700]\" data-kid=\"1-1-2-5-1-1-1\" data-name=\"activity icon\">\n                        </i>\n                        Inference Pipeline History\n                    </h3>\n                    <div class=\"flex items-center gap-4 text-[10px] font-bold uppercase\" data-kid=\"1-1-2-5-1-2\" data-name=\"table status container\">\n                        <span class=\"text-green-500 flex items-center gap-1.5\" data-kid=\"1-1-2-5-1-2-1\" data-name=\"sync status indicator\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse\" data-kid=\"1-1-2-5-1-2-1-1\" data-name=\"pulse dot\">\n                            </span>\n                            Live Sync Active\n                        </span>\n                        <span class=\"opacity-30\" data-kid=\"1-1-2-5-1-2-2\" data-name=\"separator\">\n                            |\n                        </span>\n                        <span class=\"opacity-50\" data-kid=\"1-1-2-5-1-2-3\" data-name=\"filter text\">\n                            Filter: All Dataset\n                        </span>\n                    </div>\n                </div>\n                <div class=\"overflow-x-auto\" data-kid=\"1-1-2-5-2\" data-name=\"table wrapper\">\n                    <table class=\"w-full text-left text-[11px] uppercase font-bold border-collapse\" data-kid=\"1-1-2-5-2-1\" data-name=\"history data table\">\n                        <thead class=\"bg-black text-[#FFD700]/50 border-b-2 border-[#4a4a5a]\" data-kid=\"1-1-2-5-2-1-1\" data-name=\"table header row\">\n                            <tr data-kid=\"1-1-2-5-2-1-1-1\" data-name=\"id header\">\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-1\">\n                                    ID\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-2\" data-name=\"image type header\">\n                                    Image Type\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-3\" data-name=\"species header\">\n                                    Species\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-4\" data-name=\"confidence header\">\n                                    Confidence\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-5\" data-name=\"max temp header\">\n                                    Max Temp\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest\" data-kid=\"1-1-2-5-2-1-1-1-6\" data-name=\"status header\">\n                                    Status\n                                </th>\n                                <th class=\"p-5 font-black tracking-widest text-right\" data-kid=\"1-1-2-5-2-1-1-1-7\" data-name=\"actions header\">\n                                    Actions\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-[#4a4a5a]/20\" data-kid=\"1-1-2-5-2-1-2\" data-name=\"table body\">\n                            <tr class=\"hover:bg-[#FFD700]/10 group cursor-default\" data-kid=\"1-1-2-5-2-1-2-1\" data-name=\"row one data\">\n                                <td class=\"p-6 text-white font-black text-sm\" data-kid=\"1-1-2-5-2-1-2-1-1\" data-name=\"row one id\">\n                                    TH-X902\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-1-2\" data-name=\"row one image type container\">\n                                    <span class=\"bg-[#FFD700]/20 text-[#FFD700] px-2 py-0.5 border-2 border-[#FFD700]/40\" data-kid=\"1-1-2-5-2-1-2-1-2-1\" data-name=\"row one image type badge\">\n                                        Thermal\n                                    </span>\n                                </td>\n                                <td class=\"p-6 text-white font-bold\" data-kid=\"1-1-2-5-2-1-2-1-3\" data-name=\"row one species\">\n                                    Panthera tigris\n                                </td>\n                                <td class=\"p-6 text-[#FFD700] font-black\" data-kid=\"1-1-2-5-2-1-2-1-4\" data-name=\"row one confidence\">\n                                    97.8%\n                                </td>\n                                <td class=\"p-6 text-[#FF2400] font-black\" data-kid=\"1-1-2-5-2-1-2-1-5\" data-name=\"row one max temp\">\n                                    39.4°C\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-1-6\" data-name=\"row one status container\">\n                                    <span class=\"text-green-500 border-2 border-green-500/30 px-3 py-1 bg-green-500/10 font-black\" data-kid=\"1-1-2-5-2-1-2-1-6-1\" data-name=\"row one status badge\">\n                                        COMPLETED\n                                    </span>\n                                </td>\n                                <td class=\"p-6 text-right\" data-kid=\"1-1-2-5-2-1-2-1-7\" data-name=\"row one actions container\">\n                                    <button class=\"hover:text-[#FFD700]\" data-kid=\"1-1-2-5-2-1-2-1-7-1\" data-name=\"row one download button\">\n                                        <i class=\"ti ti-download-cloud text-2xl\" data-kid=\"1-1-2-5-2-1-2-1-7-1-1\" data-name=\"download icon\">\n                                        </i>\n                                    </button>\n                                </td>\n                            </tr>\n                            <tr class=\"opacity-40 hover:opacity-100 transition-opacity duration-300 group\" data-kid=\"1-1-2-5-2-1-2-2\" data-name=\"row two data\">\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-1\" data-name=\"row two placeholder id\">\n                                    --\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-2\" data-name=\"row two placeholder image type\">\n                                    --\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-3\" data-name=\"row two placeholder species\">\n                                    --\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-4\" data-name=\"row two placeholder confidence\">\n                                    --\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-5\" data-name=\"row two placeholder max temp\">\n                                    --\n                                </td>\n                                <td class=\"p-6\" data-kid=\"1-1-2-5-2-1-2-2-6\" data-name=\"row two status container\">\n                                    <span class=\"text-white/70 border-2 border-white/20 px-3 py-1 bg-white/10 font-black\" data-kid=\"1-1-2-5-2-1-2-2-6-1\" data-name=\"row two status badge\">\n                                        AWAITING\n                                    </span>\n                                </td>\n                                <td class=\"p-6 text-right\" data-kid=\"1-1-2-5-2-1-2-2-7\" data-name=\"row two download placeholder\">\n                                    <i class=\"ti ti-download-cloud text-2xl opacity-20\" data-kid=\"1-1-2-5-2-1-2-2-7-1\" data-name=\"download icon\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"opacity-10 hover:opacity-100 transition-opacity duration-300 group\" data-kid=\"1-1-2-5-2-1-2-3\" data-name=\"row three data\">\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-1\" data-name=\"row three placeholder id\">\n                                    --\n                                </td>\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-2\" data-name=\"row three placeholder image type\">\n                                    --\n                                </td>\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-3\" data-name=\"row three placeholder species\">\n                                    --\n                                </td>\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-4\" data-name=\"row three placeholder confidence\">\n                                    --\n                                </td>\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-5\" data-name=\"row three placeholder max temp\">\n                                    --\n                                </td>\n                                <td class=\"p-5\" data-kid=\"1-1-2-5-2-1-2-3-6\" data-name=\"row three status container\">\n                                    <span class=\"text-white/50 border border-white/10 px-3 py-1 bg-white/5 rounded-xs\" data-kid=\"1-1-2-5-2-1-2-3-6-1\" data-name=\"row three status badge\">\n                                        AWAITING\n                                    </span>\n                                </td>\n                                <td class=\"p-5 text-right\" data-kid=\"1-1-2-5-2-1-2-3-7\" data-name=\"row three download placeholder\">\n                                    <i class=\"ti ti-download-cloud text-xl opacity-20\" data-kid=\"1-1-2-5-2-1-2-3-7-1\" data-name=\"download icon\">\n                                    </i>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"p-6 bg-black/40 text-[10px] font-black opacity-30 text-center uppercase tracking-[0.5em] border-t-2 border-[#4a4a5a]\" data-kid=\"1-1-2-5-3\" data-name=\"history footer notice\">\n                    History populates after first inference session\n                </div>\n            </section>\n        </main>\n        <!-- Footer Stats -->\n        <footer class=\"flex flex-col md:flex-row justify-between items-center text-[10px] font-black text-[#FFD700]/40 uppercase tracking-[0.2em] border-t-2 border-[#4a4a5a] pt-6 pb-8\" data-kid=\"1-1-3\" data-name=\"footer stats bar\">\n            <div class=\"flex gap-10\" data-kid=\"1-1-3-1\" data-name=\"stats container\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-1\" data-name=\"gpu util container\">\n                    <div class=\"w-1.5 h-1.5 bg-[#FFD700]/30\" data-kid=\"1-1-3-1-1-1\" data-name=\"gpu decorator\">\n                    </div>\n                    GPU UTIL: 0%\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-2\" data-name=\"vram container\">\n                    <div class=\"w-1.5 h-1.5 bg-[#FFD700]/30\" data-kid=\"1-1-3-1-2-1\" data-name=\"vram decorator\">\n                    </div>\n                    VRAM: 0.2 / 24.0 GB\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-3\" data-name=\"latency container\">\n                    <div class=\"w-1.5 h-1.5 bg-[#FFD700]/30\" data-kid=\"1-1-3-1-3-1\" data-name=\"latency decorator\">\n                    </div>\n                    LATENCY: 0ms\n                </span>\n            </div>\n            <div class=\"mt-4 md:mt-0 opacity-60\" data-kid=\"1-1-3-2\" data-name=\"build version info\">\n                BUILD V1.0.4-BRUTALIST // AI THERMAL CORE //\n                <span class=\"text-white\" data-kid=\"1-1-3-2-1\" data-name=\"system ready status\">\n                    SYS_READY\n                </span>\n            </div>\n        </footer>\n    </div>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n      // Combined Entrance Stagger\n      gsap.from(\".bento-cell, .bento-header\", {\n        opacity: 0,\n        y: 30,\n        duration: 0.8,\n        stagger: 0.08,\n        ease: \"power3.out\",\n        clearProps: \"all\"\n      });\n\n      // Terminal Cursor Blinking\n      gsap.to(\".terminal-cursor\", {\n        opacity: 0,\n        duration: 0.6,\n        repeat: -1,\n        ease: \"steps(1)\"\n      });\n\n      // Shimmer Movement\n      gsap.to(\".thermal-shimmer\", {\n        backgroundPosition: \"64px 64px\",\n        duration: 4,\n        repeat: -1,\n        ease: \"linear\"\n      });\n\n      // Status Pulse (handled by CSS but fine here too if needed)\n      gsap.to(\".status-pulse\", {\n        scale: 1.5,\n        opacity: 0,\n        duration: 1.5,\n        repeat: -1,\n        ease: \"power1.out\"\n      });\n      \n      // Canvas Tabs Hover Indicator (simplified for this design)\n      const tabs = document.querySelectorAll('nav a, section header button');\n      tabs.forEach(tab => {\n        tab.addEventListener('mouseenter', () => {\n          gsap.to(tab, { y: -2, duration: 0.2, ease: \"power2.out\" });\n        });\n        tab.addEventListener('mouseleave', () => {\n          gsap.to(tab, { y: 0, duration: 0.2, ease: \"power2.out\" });\n        });\n      });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-07-28T07:09:30.524270+00:00",
      "modified": "2026-07-28T07:09:30.524270+00:00",
      "id": "var_d5e06c068b87"
    },
    "var_53fc88cb80a7": {
      "type": "variant",
      "label": "Thermal Upload Workspace — Deep Space Glass",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --font-jakarta: 'Plus Jakarta Sans', sans-serif;\n        --font-ibm: 'IBM Plex Sans', sans-serif;\n        --bg-deep: #010B13;\n        --glass-navy: rgba(0, 49, 83, 0.2);\n        --cyan: #00FFFF;\n        --magenta: #FF00FF;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--bg-deep);\n        color: white;\n        font-family: var(--font-ibm);\n        overflow-x: clip;\n    }\n\n    .glass-panel {\n        background: var(--glass-navy);\n        backdrop-filter: blur(12px);\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        border-radius: 12px;\n    }\n\n    .dashed-cyan {\n        border: 1px dashed rgba(0, 255, 255, 0.3);\n    }\n\n    .cyan-glow {\n        box-shadow: 0 0 15px rgba(0, 255, 255, 0.15);\n    }\n\n    .thermal-gradient {\n        background: linear-gradient(135deg, #001A2C 0%, #003153 30%, #400040 70%, #600020 100%);\n    }\n\n    .scanline {\n        background: linear-gradient(0deg, transparent 50%, rgba(0, 255, 255, 0.05) 50%);\n        background-size: 100% 4px;\n    }\n\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n    .no-scrollbar {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    /* Custom classes for GSAP targeting to avoid style collisions */\n    .gsap-reveal { opacity: 1; visibility: visible; }\n</style>\n<div class=\"flex h-screen w-full max-w-[1280px] mx-auto overflow-hidden bg-[var(--bg-deep)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- LEFT ICON RAIL -->\n    <aside class=\"w-14 shrink-0 flex flex-col items-center py-6 border-r border-white/5 bg-black/40 z-50\" data-kid=\"1-1\" data-name=\"main navigation bar\" id=\"icon-rail\">\n        <div class=\"w-9 h-9 rounded-lg bg-[var(--cyan)] flex items-center justify-center shadow-[0_0_20px_rgba(0,255,255,0.4)] mb-10 cursor-pointer hover:scale-105 active:scale-95 transition-transform duration-200\" data-kid=\"1-1-1\" data-name=\"active workspace indicator\">\n            <i class=\"ti ti-brand-abstract text-black text-xl\" data-kid=\"1-1-1-1\" data-name=\"abstract brand icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col gap-6 text-white/30\" data-kid=\"1-1-2\" data-name=\"nav menu links\">\n            <i class=\"ti ti-layout-dashboard text-xl hover:text-white cursor-pointer transition-colors duration-200\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation icon\" title=\"Dashboard\">\n            </i>\n            <i class=\"ti ti-upload text-xl text-[var(--cyan)] cursor-pointer\" data-kid=\"1-1-2-2\" data-name=\"upload workspace navigation icon\" title=\"Upload Workspace\">\n            </i>\n            <i class=\"ti ti-history text-xl hover:text-white cursor-pointer transition-colors duration-200\" data-kid=\"1-1-2-3\" data-name=\"history navigation icon\" title=\"History\">\n            </i>\n            <i class=\"ti ti-chart-bar text-xl hover:text-white cursor-pointer transition-colors duration-200\" data-kid=\"1-1-2-4\" data-name=\"analytics navigation icon\" title=\"Analytics\">\n            </i>\n            <i class=\"ti ti-file-report text-xl hover:text-white cursor-pointer transition-colors duration-200\" data-kid=\"1-1-2-5\" data-name=\"reports navigation icon\" title=\"Reports\">\n            </i>\n            <div class=\"mt-auto flex flex-col gap-6\" data-kid=\"1-1-2-6\" data-name=\"settings container\">\n                <i class=\"ti ti-settings text-xl hover:text-white cursor-pointer transition-colors duration-200\" data-kid=\"1-1-2-6-1\" data-name=\"settings icon\" title=\"Settings\">\n                </i>\n            </div>\n        </nav>\n    </aside>\n    <!-- MAIN APP CONTAINER -->\n    <div class=\"flex-1 flex flex-col overflow-hidden relative\" data-kid=\"1-2\" data-name=\"main application work area\">\n        <!-- COMMAND BAR / HEADER -->\n        <header class=\"h-14 shrink-0 border-b border-white/5 px-6 flex items-center justify-between bg-black/20 backdrop-blur-md z-40\" data-kid=\"1-2-1\" data-name=\"header command bar\" id=\"main-header\">\n            <div class=\"flex items-center gap-4 text-sm font-medium\" data-kid=\"1-2-1-1\" data-name=\"breadcrumbs and workspace selector\">\n                <span class=\"text-white/40\" data-kid=\"1-2-1-1-1\" data-name=\"workspace label text\">\n                    Workspace\n                </span>\n                <i class=\"ti ti-chevron-right text-xs text-white/20\" data-kid=\"1-2-1-1-2\" data-name=\"chevron separator icon\">\n                </i>\n                <span class=\"text-white\" data-kid=\"1-2-1-1-3\" data-name=\"inference status text\">\n                    New inference\n                </span>\n                <div class=\"h-4 w-px bg-white/10 mx-2\" data-kid=\"1-2-1-1-4\" data-name=\"separator line\">\n                </div>\n                <div class=\"flex items-center gap-2 bg-white/5 px-3 py-1 rounded-full border border-white/10 group cursor-pointer hover:bg-white/10 transition-colors\" data-kid=\"1-2-1-1-5\" data-name=\"workspace selection button\">\n                    <span class=\"text-xs text-white/60\" data-kid=\"1-2-1-1-5-1\" data-name=\"workspace name text\">\n                        Wildlife Ops / Savanna set\n                    </span>\n                    <i class=\"ti ti-selector text-xs text-white/40\" data-kid=\"1-2-1-1-5-2\" data-name=\"selector dropdown icon\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-2-1-2\" data-name=\"header status and user profile\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1\" data-name=\"status indicator group\">\n                    <span class=\"w-2 h-2 rounded-full bg-[var(--cyan)] shadow-[0_0_8px_var(--cyan)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"status pulse dot\" id=\"status-pulse\">\n                    </span>\n                    <span class=\"text-xs font-mono text-[var(--cyan)] uppercase tracking-widest\" data-kid=\"1-2-1-2-1-2\" data-name=\"status label text\">\n                        Model Online\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-2\" data-name=\"user profile group\">\n                    <div class=\"w-8 h-8 rounded-full bg-gradient-to-tr from-[var(--cyan)] to-[var(--magenta)] flex items-center justify-center text-[10px] font-bold text-black border border-white/20 ring-2 ring-white/5 cursor-pointer\" data-kid=\"1-2-1-2-2-1\" data-name=\"user avatar placeholder\">\n                        JD\n                    </div>\n                </div>\n            </div>\n        </header>\n        <!-- MAIN SCROLLABLE CONTENT -->\n        <main class=\"flex-1 overflow-y-auto no-scrollbar p-8\" data-kid=\"1-2-2\" data-name=\"main content scrollable area\">\n            <div class=\"mb-10\" data-kid=\"1-2-2-1\" data-name=\"hero content area\" id=\"hero-text\">\n                <h1 class=\"font-[var(--font-jakarta)] text-4xl font-extrabold tracking-tight mb-2\" data-kid=\"1-2-2-1-1\" data-name=\"hero headline text\">\n                    Upload an observation\n                </h1>\n                <p class=\"text-white/40 text-sm max-w-2xl leading-relaxed\" data-kid=\"1-2-2-1-2\" data-name=\"hero subheadline description\">\n                    Intelligence-driven detection for multispectral imagery. Support for day, night, thermal, and infrared inputs with automated preprocessing.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-start\" data-kid=\"1-2-2-2\" data-name=\"content grid container\">\n                <!-- LEFT COLUMN: UPLOAD & PIPELINE -->\n                <div class=\"md:col-span-7 flex flex-col gap-8\" data-kid=\"1-2-2-2-1\" data-name=\"left column container\" id=\"left-column\">\n                    <!-- UPLOAD ZONE -->\n                    <div class=\"glass-panel p-10 dashed-cyan group hover:border-[var(--cyan)]/60 flex flex-col items-center justify-center text-center gap-6 cursor-pointer relative overflow-hidden\" data-kid=\"1-2-2-2-1-1\" data-name=\"file upload drop zone\" id=\"upload-zone\">\n                        <div class=\"absolute inset-0 bg-gradient-to-b from-[var(--cyan)]/5 to-transparent opacity-0 group-hover:opacity-100\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"upload zone hover gradient\">\n                        </div>\n                        <div class=\"w-20 h-20 rounded-xl bg-[var(--cyan)]/10 flex items-center justify-center text-[var(--cyan)] relative z-10\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"upload icon container\">\n                            <i class=\"ti ti-cloud-upload text-4xl\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"cloud upload icon\">\n                            </i>\n                        </div>\n                        <div class=\"relative z-10\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"upload instructions text\">\n                            <h3 class=\"font-[var(--font-jakarta)] text-2xl font-bold mb-2\" data-kid=\"1-2-2-2-1-1-3-1\" data-name=\"upload zone title\">\n                                Drop imagery or browse files\n                            </h3>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"1-2-2-2-1-1-3-2\" data-name=\"file format and limit info\">\n                                RAW, TIFF, JPG, PNG up to 100MB per file\n                            </p>\n                        </div>\n                        <div class=\"flex gap-4 mt-2 relative z-10\" data-kid=\"1-2-2-2-1-1-4\" data-name=\"upload action buttons container\">\n                            <button class=\"interactive-hover px-6 py-2.5 rounded-xl bg-[var(--cyan)] text-black font-bold text-sm\" data-kid=\"1-2-2-2-1-1-4-1\" data-name=\"browse files button\">\n                                Browse files\n                            </button>\n                            <button class=\"interactive-hover px-6 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white/80 font-bold text-sm\" data-kid=\"1-2-2-2-1-1-4-2\" data-name=\"use webcam button\">\n                                Use webcam\n                            </button>\n                            <button class=\"interactive-hover px-6 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white/80 font-bold text-sm\" data-kid=\"1-2-2-2-1-1-4-3\" data-name=\"import dataset button\">\n                                Import dataset\n                            </button>\n                        </div>\n                        <div class=\"mt-4 flex items-center gap-3 text-[10px] text-white/30 uppercase tracking-[0.2em] relative z-10 font-mono\" data-kid=\"1-2-2-2-1-1-5\" data-name=\"dataset types status bar\">\n                            <span class=\"text-white/50\" data-kid=\"1-2-2-2-1-1-5-1\" data-name=\"dataset status text\">\n                                Dataset slots ready\n                            </span>\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--cyan)] shadow-[0_0_5px_var(--cyan)]\" data-kid=\"1-2-2-2-1-1-5-2\" data-name=\"dataset active dot\">\n                            </span>\n                            <span class=\"hover:text-[var(--cyan)] cursor-help\" data-kid=\"1-2-2-2-1-1-5-3\" data-name=\"FLIR type label\">\n                                FLIR\n                            </span>\n                            <span class=\"text-white/10\" data-kid=\"1-2-2-2-1-1-5-4\" data-name=\"separator pipe\">\n                                |\n                            </span>\n                            <span class=\"hover:text-[var(--cyan)] cursor-help\" data-kid=\"1-2-2-2-1-1-5-5\" data-name=\"KAIST type label\">\n                                KAIST\n                            </span>\n                            <span class=\"text-white/10\" data-kid=\"1-2-2-2-1-1-5-6\" data-name=\"separator pipe\">\n                                |\n                            </span>\n                            <span class=\"hover:text-[var(--cyan)] cursor-help\" data-kid=\"1-2-2-2-1-1-5-7\" data-name=\"Roboflow type label\">\n                                Roboflow\n                            </span>\n                            <span class=\"text-white/10\" data-kid=\"1-2-2-2-1-1-5-8\" data-name=\"separator pipe\">\n                                |\n                            </span>\n                            <span class=\"hover:text-[var(--cyan)] cursor-help\" data-kid=\"1-2-2-2-1-1-5-9\" data-name=\"Custom type label\">\n                                Custom\n                            </span>\n                        </div>\n                    </div>\n                    <!-- PIPELINE STEPPER -->\n                    <div class=\"glass-panel p-8\" data-kid=\"1-2-2-2-1-2\" data-name=\"pipeline stepper panel\" id=\"pipeline-panel\">\n                        <div class=\"flex items-center justify-between mb-8\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"pipeline status header\">\n                            <div class=\"flex flex-col\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"pipeline title group\">\n                                <h4 class=\"text-xs font-bold uppercase tracking-widest text-[var(--cyan)] flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"pipeline icon\">\n                                    <i class=\"ti ti-cpu text-lg\" data-kid=\"1-2-2-2-1-2-1-1-1-1\" data-name=\"cpu icon\">\n                                    </i>\n                                    Active Pipeline\n                                </h4>\n                                <span class=\"text-[10px] text-white/30 mt-1 uppercase\" data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"engine version text\">\n                                    Unified Inference Engine v4.2\n                                </span>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"real-time progress group\">\n                                <div class=\"flex items-center gap-2 justify-end\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-name=\"progress percentage indicator\">\n                                    <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--magenta)] animate-pulse\" data-kid=\"1-2-2-2-1-2-1-2-1-1\" data-name=\"progress pulse dot\">\n                                    </span>\n                                    <span class=\"text-xl font-mono text-[var(--cyan)] font-bold\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-1-2-1-2\" data-name=\"progress percentage text\" data-reason=\"text updated to show processing percentage\">\n                                        48.2%\n                                    </span>\n                                </div>\n                                <p class=\"text-[10px] text-white/40 uppercase tracking-tighter\" data-kid=\"1-2-2-2-1-2-1-2-2\" data-name=\"progress label text\">\n                                    Real-time processing\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-1 gap-6 relative\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"pipeline steps container\">\n                            <!-- Vertical line connector -->\n                            <div class=\"absolute left-[13px] top-4 bottom-4 w-px bg-white/5 z-0\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"vertical connector line\">\n                            </div>\n                            <!-- Stage 1 -->\n                            <div class=\"flex items-start gap-5 relative z-10\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"pipeline step 1\">\n                                <div class=\"w-7 h-7 shrink-0 rounded-full bg-[var(--cyan)]/20 border border-[var(--cyan)] flex items-center justify-center\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-name=\"step status icon container\">\n                                    <i class=\"ti ti-check text-[var(--cyan)] text-xs\" data-kid=\"1-2-2-2-1-2-2-2-1-1\" data-name=\"checkmark icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex-1 border-b border-white/5 pb-4\" data-kid=\"1-2-2-2-1-2-2-2-2\" data-name=\"step content container\">\n                                    <div class=\"flex items-center justify-between mb-1\" data-kid=\"1-2-2-2-1-2-2-2-2-1\" data-name=\"step title\">\n                                        <h5 class=\"text-sm font-semibold text-[var(--cyan)]\" data-kid=\"1-2-2-2-1-2-2-2-2-1-1\" data-name=\"step title text\">\n                                            Image type detection\n                                        </h5>\n                                        <span class=\"text-[10px] font-mono text-white/30 italic\" data-kid=\"1-2-2-2-1-2-2-2-2-1-2\" data-name=\"step meta text\">\n                                            Success (Thermal)\n                                        </span>\n                                    </div>\n                                    <p class=\"text-[11px] text-white/40\" data-kid=\"1-2-2-2-1-2-2-2-2-2\" data-name=\"step description text\">\n                                        Multi-band spectral analysis confirmed high-gain thermal source.\n                                    </p>\n                                </div>\n                            </div>\n                            <!-- Stage 2 -->\n                            <div class=\"flex items-start gap-5 relative z-10\" data-kid=\"1-2-2-2-1-2-2-3\" data-name=\"pipeline step 2\">\n                                <div class=\"w-7 h-7 shrink-0 rounded-full bg-[var(--cyan)]/20 border border-[var(--cyan)] flex items-center justify-center\" data-kid=\"1-2-2-2-1-2-2-3-1\" data-name=\"step status icon container\">\n                                    <i class=\"ti ti-check text-[var(--cyan)] text-xs\" data-kid=\"1-2-2-2-1-2-2-3-1-1\" data-name=\"checkmark icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex-1 border-b border-white/5 pb-4\" data-kid=\"1-2-2-2-1-2-2-3-2\" data-name=\"step content container\">\n                                    <div class=\"flex items-center justify-between mb-1\" data-kid=\"1-2-2-2-1-2-2-3-2-1\" data-name=\"step title\">\n                                        <h5 class=\"text-sm font-semibold text-[var(--cyan)]\" data-kid=\"1-2-2-2-1-2-2-3-2-1-1\" data-name=\"step title text\">\n                                            Enhancement\n                                        </h5>\n                                        <span class=\"text-[10px] font-mono text-white/30 italic\" data-kid=\"1-2-2-2-1-2-2-3-2-1-2\" data-name=\"step meta text\">\n                                            Complete\n                                        </span>\n                                    </div>\n                                    <p class=\"text-[11px] text-white/40\" data-kid=\"1-2-2-2-1-2-2-3-2-2\" data-name=\"step description text\">\n                                        Denoising filters and CLAHE histogram equalization applied.\n                                    </p>\n                                </div>\n                            </div>\n                            <!-- Stage 3 (ACTIVE) -->\n                            <div class=\"flex items-start gap-5 relative z-10\" data-kid=\"1-2-2-2-1-2-2-4\" data-name=\"pipeline step 3 (active)\">\n                                <div class=\"w-7 h-7 shrink-0 rounded-full bg-[var(--cyan)]/20 border border-[var(--cyan)] flex items-center justify-center shadow-[0_0_15px_rgba(0,255,255,0.2)]\" data-kid=\"1-2-2-2-1-2-2-4-1\" data-name=\"active step indicator container\">\n                                    <div class=\"w-2 h-2 rounded-full bg-[var(--cyan)] shadow-[0_0_10px_var(--cyan)]\" data-kid=\"1-2-2-2-1-2-2-4-1-1\" data-name=\"active step dot\">\n                                    </div>\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"1-2-2-2-1-2-2-4-2\" data-name=\"step content container\">\n                                    <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-2-2-2-1-2-2-4-2-1\" data-name=\"step title\">\n                                        <h5 class=\"text-sm font-semibold text-[var(--cyan)]\" data-kid=\"1-2-2-2-1-2-2-4-2-1-1\" data-name=\"step title text\">\n                                            Thermal conversion\n                                        </h5>\n                                        <span class=\"text-[10px] font-mono text-[var(--cyan)]\" data-kid=\"1-2-2-2-1-2-2-4-2-1-2\" data-name=\"step number indicator\">\n                                            Stage 3/7\n                                        </span>\n                                    </div>\n                                    <div class=\"h-1.5 bg-white/5 rounded-full overflow-hidden mb-2\" data-kid=\"1-2-2-2-1-2-2-4-2-2\" data-name=\"progress bar container\">\n                                        <div class=\"h-full bg-[var(--cyan)] w-0 shadow-[0_0_10px_rgba(0,255,255,0.4)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2-4-2-2-1\" data-name=\"progress bar fill\" data-reason=\"width updated by script during animation\" id=\"pipeline-progress-bar\">\n                                        </div>\n                                    </div>\n                                    <p class=\"text-[11px] text-white/60\" data-kid=\"1-2-2-2-1-2-2-4-2-3\" data-name=\"step processing description\">\n                                        Estimating temperature deltas and normalizing radiance gradients...\n                                    </p>\n                                </div>\n                            </div>\n                            <!-- Stage 4-7 (Queued) -->\n                            <div class=\"flex items-start gap-5 relative z-10 opacity-50\" data-kid=\"1-2-2-2-1-2-2-5\" data-name=\"pipeline step 4 (queued)\">\n                                <div class=\"w-7 h-7 shrink-0 rounded-full border border-white/20 flex items-center justify-center\" data-kid=\"1-2-2-2-1-2-2-5-1\" data-name=\"step number container\">\n                                    <span class=\"text-[10px] font-bold\" data-kid=\"1-2-2-2-1-2-2-5-1-1\" data-name=\"step number\">\n                                        4\n                                    </span>\n                                </div>\n                                <div class=\"flex-1 border-b border-white/5 pb-4\" data-kid=\"1-2-2-2-1-2-2-5-2\" data-name=\"step content container\">\n                                    <h5 class=\"text-sm font-semibold\" data-kid=\"1-2-2-2-1-2-2-5-2-1\" data-name=\"step title text\">\n                                        Animal Detection & Localization\n                                    </h5>\n                                    <p class=\"text-[11px]\" data-kid=\"1-2-2-2-1-2-2-5-2-2\" data-name=\"step description text\">\n                                        YOLO-v8 inference with multi-scale anchor boxes.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex items-start gap-5 relative z-10 opacity-40\" data-kid=\"1-2-2-2-1-2-2-6\" data-name=\"pipeline step 5 (queued)\">\n                                <div class=\"w-7 h-7 shrink-0 rounded-full border border-white/20 flex items-center justify-center\" data-kid=\"1-2-2-2-1-2-2-6-1\" data-name=\"step number container\">\n                                    <span class=\"text-[10px] font-bold\" data-kid=\"1-2-2-2-1-2-2-6-1-1\" data-name=\"step number\">\n                                        5\n                                    </span>\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"1-2-2-2-1-2-2-6-2\" data-name=\"step content container\">\n                                    <h5 class=\"text-sm font-semibold\" data-kid=\"1-2-2-2-1-2-2-6-2-1\" data-name=\"step title text\">\n                                        Segmentation & Masking\n                                    </h5>\n                                    <p class=\"text-[11px]\" data-kid=\"1-2-2-2-1-2-2-6-2-2\" data-name=\"step description text\">\n                                        Segment Anything Model (SAM) instance isolation.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- RIGHT COLUMN: PREVIEW & INSPECTOR -->\n                <div class=\"md:col-span-5 flex flex-col gap-8\" data-kid=\"1-2-2-2-2\" data-name=\"right column container\" id=\"right-column\">\n                    <!-- THERMAL PREVIEW CANVAS -->\n                    <div class=\"glass-panel aspect-[4/3] relative overflow-hidden group\" data-kid=\"1-2-2-2-2-1\" data-name=\"thermal preview canvas panel\" id=\"preview-canvas\">\n                        <!-- Thermal Gradient Base -->\n                        <div class=\"absolute inset-0 thermal-gradient opacity-60\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"canvas background gradient\">\n                        </div>\n                        <!-- Scanline Overlay -->\n                        <div class=\"absolute inset-0 scanline opacity-30 pointer-events-none\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"canvas scanline overlay\" id=\"canvas-scanline\">\n                        </div>\n                        <!-- Grid Overlay -->\n                        <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"canvas grid overlay\" style=\"background-image: radial-gradient(circle at 1px 1px, rgba(0,255,255,0.08) 1.5px, transparent 0); background-size: 32px 32px;\">\n                        </div>\n                        <!-- Empty State Content -->\n                        <div class=\"absolute inset-0 flex flex-col items-center justify-center text-center p-12 bg-black/50 backdrop-blur-[2px] z-10\" data-kid=\"1-2-2-2-2-1-4\" data-name=\"canvas empty state\">\n                            <div class=\"w-20 h-20 border border-dashed border-white/10 rounded-full flex items-center justify-center mb-6\" data-kid=\"1-2-2-2-2-1-4-1\" data-name=\"placeholder icon container\">\n                                <i class=\"ti ti-photo-circle text-3xl text-white/10\" data-kid=\"1-2-2-2-2-1-4-1-1\" data-name=\"empty state icon\">\n                                </i>\n                            </div>\n                            <h4 class=\"font-[var(--font-jakarta)] text-lg font-bold text-white/40 tracking-tight\" data-kid=\"1-2-2-2-2-1-4-2\" data-name=\"empty state title\">\n                                Dataset preview\n                            </h4>\n                            <p class=\"text-white/20 text-xs mt-2 max-w-[200px]\" data-kid=\"1-2-2-2-2-1-4-3\" data-name=\"empty state description\">\n                                Waiting for upload to visualize inference frames.\n                            </p>\n                        </div>\n                        <!-- UI Overlays -->\n                        <div class=\"absolute top-4 left-1/2 -translate-x-1/2 flex gap-1 p-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10 z-20\" data-kid=\"1-2-2-2-2-1-5\" data-name=\"preview view mode selector\">\n                            <button class=\"interactive-hover px-4 py-1.5 text-[9px] uppercase font-bold text-white/40 hover:text-white\" data-kid=\"1-2-2-2-2-1-5-1\" data-name=\"view mode button 1\">\n                                Original\n                            </button>\n                            <button class=\"px-4 py-1.5 text-[9px] uppercase font-bold text-black bg-[var(--cyan)] rounded-full shadow-[0_0_10px_rgba(0,255,255,0.4)]\" data-kid=\"1-2-2-2-2-1-5-2\" data-name=\"view mode button 2 (active)\">\n                                Thermal\n                            </button>\n                            <button class=\"interactive-hover px-4 py-1.5 text-[9px] uppercase font-bold text-white/40 hover:text-white\" data-kid=\"1-2-2-2-2-1-5-3\" data-name=\"view mode button 3\">\n                                Mask\n                            </button>\n                            <button class=\"interactive-hover px-4 py-1.5 text-[9px] uppercase font-bold text-white/40 hover:text-white\" data-kid=\"1-2-2-2-2-1-5-4\" data-name=\"view mode button 4\">\n                                Edges\n                            </button>\n                        </div>\n                        <!-- Metadata -->\n                        <div class=\"absolute bottom-4 right-4 text-[10px] font-mono text-white/40 text-right z-20 pointer-events-none\" data-kid=\"1-2-2-2-2-1-6\" data-name=\"canvas metadata display\">\n                            <div class=\"mb-1\" data-kid=\"1-2-2-2-2-1-6-1\" data-name=\"objects detected label\">\n                                — objects detected\n                            </div>\n                            <div data-kid=\"1-2-2-2-2-1-6-2\" data-name=\"avg temperature label\">\n                                — °C avg temperature\n                            </div>\n                        </div>\n                        <!-- Crosshair UI -->\n                        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 pointer-events-none opacity-20\" data-kid=\"1-2-2-2-2-1-7\" data-name=\"canvas crosshair UI\">\n                            <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-px h-6 bg-[var(--cyan)]\" data-kid=\"1-2-2-2-2-1-7-1\" data-name=\"crosshair top arm\">\n                            </div>\n                            <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-6 bg-[var(--cyan)]\" data-kid=\"1-2-2-2-2-1-7-2\" data-name=\"crosshair bottom arm\">\n                            </div>\n                            <div class=\"absolute left-0 top-1/2 -translate-y-1/2 h-px w-6 bg-[var(--cyan)]\" data-kid=\"1-2-2-2-2-1-7-3\" data-name=\"crosshair left arm\">\n                            </div>\n                            <div class=\"absolute right-0 top-1/2 -translate-y-1/2 h-px w-6 bg-[var(--cyan)]\" data-kid=\"1-2-2-2-2-1-7-4\" data-name=\"crosshair right arm\">\n                            </div>\n                            <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full border border-[var(--cyan)]/50\" data-kid=\"1-2-2-2-2-1-7-5\" data-name=\"crosshair center ring\">\n                            </div>\n                        </div>\n                    </div>\n                    <!-- INSPECTOR PANEL -->\n                    <div class=\"glass-panel p-8 flex flex-col gap-6 flex-1 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)]\" data-kid=\"1-2-2-2-2-2\" data-name=\"inspector panel\" id=\"inspector-panel\">\n                        <div data-kid=\"1-2-2-2-2-2-1\" data-name=\"inference profile section\">\n                            <h4 class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-white/40 mb-4 flex items-center justify-between\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"inference profile label\">\n                                Inference Profile\n                                <i class=\"ti ti-info-circle text-xs\" data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"info icon\">\n                                </i>\n                            </h4>\n                            <div class=\"interactive-hover flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/5 cursor-pointer group\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"inference profile selector\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"profile selection summary\">\n                                    <div class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center border border-white/10 text-[var(--cyan)]\" data-kid=\"1-2-2-2-2-2-1-2-1-1\" data-name=\"chip icon container\">\n                                        <i class=\"ti ti-microchip text-xl\" data-kid=\"1-2-2-2-2-2-1-2-1-1-1\" data-name=\"microchip icon\">\n                                        </i>\n                                    </div>\n                                    <div data-kid=\"1-2-2-2-2-2-1-2-1-2\" data-name=\"profile names description\">\n                                        <p class=\"text-sm font-bold\" data-kid=\"1-2-2-2-2-2-1-2-1-2-1\" data-name=\"profile name\">\n                                            YOLO + SAM + EfficientNet\n                                        </p>\n                                        <p class=\"text-[10px] text-white/30 uppercase tracking-tighter\" data-kid=\"1-2-2-2-2-2-1-2-1-2-2\" data-name=\"profile engine version\">\n                                            Unified Multispectral v4.2\n                                        </p>\n                                    </div>\n                                </div>\n                                <i class=\"ti ti-chevron-down text-white/20 group-hover:text-white transition-colors\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"dropdown chevron\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"auto-detect input toggle container\">\n                            <span class=\"text-xs text-white/60 font-medium\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"auto-detect label\">\n                                Auto-detect input\n                            </span>\n                            <div class=\"w-11 h-6 bg-[var(--cyan)] rounded-full relative p-1 cursor-pointer\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"toggle switch\">\n                                <div class=\"w-4 h-4 bg-black rounded-full shadow-sm ml-auto\" data-kid=\"1-2-2-2-2-2-2-2-1\" data-name=\"toggle switch thumb\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"parameter control container\">\n                            <div data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"confidence threshold group\">\n                                <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-2-2-2-2-2-3-1-1\" data-name=\"threshold label group\">\n                                    <span class=\"text-xs text-white/60 font-medium\" data-kid=\"1-2-2-2-2-2-3-1-1-1\" data-name=\"threshold label\">\n                                        Confidence Threshold\n                                    </span>\n                                    <span class=\"text-xs font-mono text-[var(--cyan)] font-bold\" data-kid=\"1-2-2-2-2-2-3-1-1-2\" data-name=\"threshold value\">\n                                        0.50\n                                    </span>\n                                </div>\n                                <div class=\"h-1.5 bg-white/5 rounded-full relative cursor-pointer\" data-kid=\"1-2-2-2-2-2-3-1-2\" data-name=\"slider bar container\">\n                                    <div class=\"absolute top-1/2 -translate-y-1/2 left-1/2 w-4 h-4 bg-[var(--cyan)] rounded-full border-2 border-black shadow-lg\" data-kid=\"1-2-2-2-2-2-3-1-2-1\" data-name=\"slider handle\">\n                                    </div>\n                                    <div class=\"h-full bg-[var(--cyan)] w-1/2 rounded-full shadow-[0_0_10px_rgba(0,255,255,0.3)]\" data-kid=\"1-2-2-2-2-2-3-1-2-2\" data-name=\"slider active track\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex items-center justify-between text-xs py-1\" data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"target classes group\">\n                                <span class=\"text-white/60\" data-kid=\"1-2-2-2-2-2-3-2-1\" data-name=\"target classes label\">\n                                    Target classes\n                                </span>\n                                <span class=\"text-white font-bold\" data-kid=\"1-2-2-2-2-2-3-2-2\" data-name=\"target classes count\">\n                                    20 animal classes\n                                </span>\n                            </div>\n                        </div>\n                        <button class=\"w-full py-4 rounded-2xl bg-white/5 text-white/20 border border-white/5 font-bold text-sm cursor-not-allowed group relative overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-4\" data-name=\"inference execution button\" data-reason=\"text and styles updated by script to reflect ready state\" id=\"inference-btn\">\n                            <span class=\"relative z-10\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-4-1\" data-name=\"inference button text\" data-reason=\"text updated by script to show ready state\">\n                                Run inference\n                            </span>\n                        </button>\n                        <div class=\"pt-4 border-t border-white/5\" data-kid=\"1-2-2-2-2-2-5\" data-name=\"temperature spectrum scale\">\n                            <div class=\"flex justify-between text-[9px] text-white/40 mb-2 font-mono uppercase font-bold tracking-widest\" data-kid=\"1-2-2-2-2-2-5-1\" data-name=\"temperature range label group\">\n                                <span data-kid=\"1-2-2-2-2-2-5-1-1\" data-name=\"cold limit text\">\n                                    Cold (-20°C)\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-2-5-1-2\" data-name=\"gradient label\">\n                                    Radiance gradient\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-2-5-1-3\" data-name=\"hot limit text\">\n                                    Hot (65°C)\n                                </span>\n                            </div>\n                            <div class=\"h-3 rounded-full bg-gradient-to-r from-[#000033] via-[#003153] via-[#00FFFF] via-[#FF00FF] to-[#FFFF00] shadow-[inset_0_1px_4px_rgba(0,0,0,0.5)]\" data-kid=\"1-2-2-2-2-2-5-2\" data-name=\"temperature gradient bar\">\n                            </div>\n                            <div class=\"flex justify-between px-1 mt-2\" data-kid=\"1-2-2-2-2-2-5-3\" data-name=\"gradient ticks container\">\n                                <span class=\"w-0.5 h-1 bg-white/20\" data-kid=\"1-2-2-2-2-2-5-3-1\" data-name=\"tick mark 1\">\n                                </span>\n                                <span class=\"w-0.5 h-1 bg-white/20\" data-kid=\"1-2-2-2-2-2-5-3-2\" data-name=\"tick mark 2\">\n                                </span>\n                                <span class=\"w-0.5 h-1 bg-white/20\" data-kid=\"1-2-2-2-2-2-5-3-3\" data-name=\"tick mark 3\">\n                                </span>\n                                <span class=\"w-0.5 h-1 bg-white/20\" data-kid=\"1-2-2-2-2-2-5-3-4\" data-name=\"tick mark 4\">\n                                </span>\n                                <span class=\"w-0.5 h-1 bg-white/20\" data-kid=\"1-2-2-2-2-2-5-3-5\" data-name=\"tick mark 5\">\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n        <!-- BOTTOM STRIP / RECENT QUEUE -->\n        <footer class=\"shrink-0 border-t border-white/5 bg-black/40 backdrop-blur-xl p-8 flex flex-col gap-6 h-auto\" data-kid=\"1-2-3\" data-name=\"footer activity drawer\" id=\"bottom-drawer\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1\" data-name=\"queue header container\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-1\" data-name=\"activity status group\">\n                    <h5 class=\"text-xs font-bold uppercase tracking-[0.2em] text-white/60\" data-kid=\"1-2-3-1-1-1\" data-name=\"activity queue label\">\n                        Recent Activity Queue\n                    </h5>\n                    <span class=\"px-2 py-0.5 rounded bg-[var(--cyan)]/10 text-[var(--cyan)] text-[10px] font-bold\" data-kid=\"1-2-3-1-1-2\" data-name=\"task count badge\">\n                        4 Active Tasks\n                    </span>\n                </div>\n                <button class=\"text-[11px] text-[var(--cyan)] font-bold hover:underline underline-offset-4 decoration-2 decoration-[var(--cyan)]/30\" data-kid=\"1-2-3-1-2\" data-name=\"view history button\">\n                    View Inference History\n                    <i class=\"ti ti-arrow-right ml-1\" data-kid=\"1-2-3-1-2-1\" data-name=\"arrow icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\" data-kid=\"1-2-3-2\" data-name=\"queue items grid\">\n                <!-- Queue Item 1 -->\n                <div class=\"interactive-hover flex items-center gap-4 bg-white/5 border border-white/5 p-3 rounded-xl group\" data-kid=\"1-2-3-2-1\" data-name=\"queue item 1\">\n                    <div class=\"w-12 h-12 shrink-0 bg-black rounded-lg border border-white/10 flex items-center justify-center text-[var(--magenta)] relative overflow-hidden\" data-kid=\"1-2-3-2-1-1\" data-name=\"queue item thumbnail container\">\n                        <div class=\"absolute inset-0 thermal-gradient opacity-40\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"thumbnail background\">\n                        </div>\n                        <i class=\"ti ti-photo-circle text-2xl relative z-10\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"thumbnail icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 min-w-0\" data-kid=\"1-2-3-2-1-2\" data-name=\"queue item details container\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"queue item name row\">\n                            <p class=\"text-xs font-bold truncate\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"queue item filename\">\n                                Savanna_Tiger_X02.tiff\n                            </p>\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--magenta)] shadow-[0_0_5px_var(--magenta)]\" data-kid=\"1-2-3-2-1-2-1-2\" data-name=\"queue item status warning\" title=\"High Heat Warning\">\n                            </span>\n                        </div>\n                        <p class=\"text-[10px] text-white/30 uppercase tracking-tighter mt-0.5\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"queue item description\">\n                            Thermal Frame • 24MB\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-2-3-2-1-3\" data-name=\"queue item action container\">\n                        <span class=\"px-2 py-0.5 rounded-md bg-[var(--cyan)]/10 text-[var(--cyan)] text-[9px] font-bold uppercase border border-[var(--cyan)]/20 shadow-[0_0_10px_rgba(0,255,255,0.05)]\" data-kid=\"1-2-3-2-1-3-1\" data-name=\"queue item status badge\">\n                            Success\n                        </span>\n                        <i class=\"ti ti-download text-white/30 hover:text-[var(--cyan)] cursor-pointer\" data-kid=\"1-2-3-2-1-3-2\" data-name=\"download icon\">\n                        </i>\n                    </div>\n                </div>\n                <!-- Queue Item 2 -->\n                <div class=\"interactive-hover flex items-center gap-4 bg-white/5 border border-white/5 p-3 rounded-xl group\" data-kid=\"1-2-3-2-2\" data-name=\"queue item 2\">\n                    <div class=\"w-12 h-12 shrink-0 bg-black rounded-lg border border-white/10 flex items-center justify-center text-[var(--cyan)] relative overflow-hidden\" data-kid=\"1-2-3-2-2-1\" data-name=\"queue item thumbnail container\">\n                        <div class=\"absolute inset-0 bg-blue-900/40 opacity-40\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"thumbnail background\">\n                        </div>\n                        <i class=\"ti ti-moon-2 text-2xl relative z-10\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"thumbnail icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 min-w-0\" data-kid=\"1-2-3-2-2-2\" data-name=\"queue item details container\">\n                        <p class=\"text-xs font-bold truncate\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"queue item filename\">\n                            Night_Feed_North_Gate.mp4\n                        </p>\n                        <p class=\"text-[10px] text-white/30 uppercase tracking-tighter mt-0.5\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"queue item description\">\n                            IR Video • Stream\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-2-3-2-2-3\" data-name=\"queue item action container\">\n                        <span class=\"px-2 py-0.5 rounded-md bg-white/10 text-white/60 text-[9px] font-bold uppercase border border-white/10\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"queue item status badge\">\n                            Processing\n                        </span>\n                        <i class=\"ti ti-external-link text-white/30 hover:text-[var(--cyan)] cursor-pointer\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"external link icon\">\n                        </i>\n                    </div>\n                </div>\n                <!-- Queue Item 3 -->\n                <div class=\"interactive-hover flex items-center gap-4 bg-white/5 border border-white/5 p-3 rounded-xl group opacity-60\" data-kid=\"1-2-3-2-3\" data-name=\"queue item 3\">\n                    <div class=\"w-12 h-12 shrink-0 bg-black rounded-lg border border-white/10 flex items-center justify-center text-white/20\" data-kid=\"1-2-3-2-3-1\" data-name=\"queue item thumbnail container\">\n                        <i class=\"ti ti-file-text text-2xl\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"thumbnail icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 min-w-0\" data-kid=\"1-2-3-2-3-2\" data-name=\"queue item details container\">\n                        <p class=\"text-xs font-bold truncate\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"queue item filename\">\n                            Batch_Report_Savanna.pdf\n                        </p>\n                        <p class=\"text-[10px] text-white/20 uppercase tracking-tighter mt-0.5\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"queue item description\">\n                            Inference Report • PDF\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-2-3-2-3-3\" data-name=\"queue item action container\">\n                        <span class=\"px-2 py-0.5 rounded-md bg-white/5 text-white/30 text-[9px] font-bold uppercase border border-white/5\" data-kid=\"1-2-3-2-3-3-1\" data-name=\"queue item status badge\">\n                            Queued\n                        </span>\n                        <i class=\"ti ti-clock text-white/20\" data-kid=\"1-2-3-2-3-3-2\" data-name=\"clock icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    document.addEventListener('DOMContentLoaded', () => {\n        const tl = gsap.timeline({ defaults: { ease: 'power4.out', duration: 1 } });\n\n        // Entrance Animations\n        tl.from('#icon-rail', { x: -60, opacity: 0 }, 0);\n        tl.from('#main-header', { y: -60, opacity: 0 }, 0.2);\n        tl.from('#hero-text', { y: 30, opacity: 0 }, 0.4);\n        \n        tl.from('#left-column', { x: -30, opacity: 0 }, 0.6);\n        tl.from('#right-column', { x: 30, opacity: 0 }, 0.6);\n        tl.from('#bottom-drawer', { y: 60, opacity: 0 }, 0.8);\n\n        // Scanline Animation\n        gsap.to('#canvas-scanline', {\n            y: '100%',\n            repeat: -1,\n            duration: 8,\n            ease: 'linear'\n        });\n\n        // Status Pulse\n        gsap.to('#status-pulse', {\n            scale: 1.8,\n            opacity: 0.2,\n            repeat: -1,\n            yoyo: true,\n            duration: 1.2,\n            ease: 'sine.inOut'\n        });\n\n        // Pipeline Progress Fill\n        gsap.to('#pipeline-progress-bar', {\n            width: '48.2%',\n            duration: 2.5,\n            delay: 1.5,\n            ease: 'expo.out'\n        });\n\n        // Hover interactions using GSAP for smooth scale/color\n        const interactiveElements = document.querySelectorAll('.interactive-hover');\n        interactiveElements.forEach(el => {\n            el.addEventListener('mouseenter', () => {\n                gsap.to(el, { scale: 1.02, duration: 0.4 });\n            });\n            el.addEventListener('mouseleave', () => {\n                gsap.to(el, { scale: 1, duration: 0.4 });\n            });\n        });\n\n        // Simulation of \"Ready\" state after a delay\n        setTimeout(() => {\n            gsap.to('#inference-btn', {\n                backgroundColor: 'rgba(0, 255, 255, 0.1)',\n                color: '#00FFFF',\n                borderColor: 'rgba(0, 255, 255, 0.4)',\n                cursor: 'pointer',\n                duration: 1\n            });\n            const btnText = document.querySelector('#inference-btn span');\n            if (btnText) btnText.innerHTML = 'Run inference (Ready)';\n        }, 4000);\n    });\n</script>\n",
      "comments": [],
      "created": "2026-07-28T07:09:30.730142+00:00",
      "modified": "2026-07-28T07:09:30.730142+00:00",
      "id": "var_53fc88cb80a7"
    },
    "var_260a5a6ce105": {
      "type": "variant",
      "label": "Thermal Upload Workspace — Tactical Command",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"flex flex-col h-screen w-full bg-[#111111] text-white font-['Fira_Sans'] overflow-hidden selection:bg-[#39FF14]/30 selection:text-[#39FF14]\" data-kid=\"1\" data-name=\"application layout container\">\n    <link data-kid=\"1-1\" data-name=\"font-awesome and icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Sans:wght@300;400;500;600&family=Fira+Mono:wght@400;500;700&display=swap');\n    \n    .font-space { font-family: 'Space Grotesk', sans-serif; }\n    .font-fira { font-family: 'Fira Sans', sans-serif; }\n    .font-mono { font-family: 'Fira Mono', monospace; }\n\n    /* Tactical Viewport Background Grid */\n    .thermal-grid {\n      background-image: \n        linear-gradient(to right, rgba(57, 255, 20, 0.03) 1px, transparent 1px),\n        linear-gradient(to bottom, rgba(57, 255, 20, 0.03) 1px, transparent 1px);\n      background-size: 32px 32px;\n    }\n    \n    /* Scanline Animation Effect */\n    .scanline {\n      height: 1px;\n      background: linear-gradient(to bottom, transparent, #39FF14, transparent);\n      opacity: 0.15;\n      width: 100%;\n      position: absolute;\n      top: 0;\n      left: 0;\n      pointer-events: none;\n      z-index: 10;\n    }\n\n    /* Corner Brackets for HUD */\n    .corner-bracket {\n      position: absolute;\n      width: 16px;\n      height: 16px;\n      border: 1px solid #39FF14;\n      z-index: 20;\n    }\n    .cb-tl { top: 12px; left: 12px; border-right: 0; border-bottom: 0; }\n    .cb-tr { top: 12px; right: 12px; border-left: 0; border-bottom: 0; }\n    .cb-bl { bottom: 12px; left: 12px; border-right: 0; border-top: 0; }\n    .cb-br { bottom: 12px; right: 12px; border-left: 0; border-top: 0; }\n\n    .bracket-corner {\n      position: absolute;\n      width: 8px;\n      height: 8px;\n      border-color: #39FF14;\n      border-width: 1px;\n    }\n\n    /* Ticket Notch Effect */\n    .ticket-card {\n      position: relative;\n      background: #1A1A1A;\n      border: 1px solid rgba(255,255,255,0.05);\n    }\n    .ticket-card::before, .ticket-card::after {\n      content: '';\n      position: absolute;\n      top: 50%;\n      width: 12px;\n      height: 12px;\n      background: #111111;\n      border-radius: 50%;\n      transform: translateY(-50%);\n      border: 1px solid rgba(255,255,255,0.08);\n    }\n    .ticket-card::before { left: -7px; }\n    .ticket-card::after { right: -7px; }\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 4px; height: 4px; }\n    ::-webkit-scrollbar-track { background: #111; }\n    ::-webkit-scrollbar-thumb { background: #333; border-radius: 0px; }\n    ::-webkit-scrollbar-thumb:hover { background: #39FF14; }\n\n    .reticle-dash {\n      border: 1px dashed rgba(57, 255, 20, 0.15);\n      border-radius: 50%;\n    }\n\n    .vignette {\n      background: radial-gradient(circle, transparent 50%, rgba(0,0,0,0.9) 100%);\n      pointer-events: none;\n    }\n\n    .status-pulse {\n      box-shadow: 0 0 10px #39FF14;\n    }\n    </style>\n    <!-- Upper Workspace Section -->\n    <div class=\"flex flex-grow min-h-0\" data-kid=\"1-2\" data-name=\"upper workspace section\">\n        <!-- Left Rail Navigation -->\n        <aside class=\"w-[80px] flex-shrink-0 bg-[#0c0c0c] border-r border-white/5 flex flex-col items-center py-8 z-50\" data-kid=\"1-2-1\" data-name=\"left rail navigation\">\n            <div class=\"mb-12\" data-kid=\"1-2-1-1\" data-name=\"brand logo container\">\n                <div class=\"w-10 h-10 border border-[#39FF14] flex items-center justify-center font-space font-bold text-[#39FF14] text-[10px] leading-tight text-center\" data-kid=\"1-2-1-1-1\" data-name=\"brand logo text\">\n                    T//O\n                </div>\n            </div>\n            <nav class=\"flex flex-col gap-8 flex-grow\" data-kid=\"1-2-1-2\" data-name=\"primary navigation links\">\n                <a class=\"text-white/60 hover:text-[#39FF14]\" data-kid=\"1-2-1-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                    <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"1-2-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </a>\n                <a class=\"text-[#39FF14] relative\" data-kid=\"1-2-1-2-2\" data-name=\"upload navigation link\" href=\"#\">\n                    <i class=\"ti ti-upload text-2xl\" data-kid=\"1-2-1-2-2-1\" data-name=\"upload icon\">\n                    </i>\n                    <div class=\"absolute -right-[23px] top-1/2 -translate-y-1/2 w-[3px] h-6 bg-[#39FF14] shadow-[0_0_8px_#39FF14]\" data-kid=\"1-2-1-2-2-2\" data-name=\"active navigation indicator\">\n                    </div>\n                </a>\n                <a class=\"text-white/60 hover:text-[#39FF14]\" data-kid=\"1-2-1-2-3\" data-name=\"analytics navigation link\" href=\"#\">\n                    <i class=\"ti ti-chart-dots text-2xl\" data-kid=\"1-2-1-2-3-1\" data-name=\"analytics icon\">\n                    </i>\n                </a>\n                <a class=\"text-white/60 hover:text-[#39FF14]\" data-kid=\"1-2-1-2-4\" data-name=\"history navigation link\" href=\"#\">\n                    <i class=\"ti ti-history text-2xl\" data-kid=\"1-2-1-2-4-1\" data-name=\"history icon\">\n                    </i>\n                </a>\n                <a class=\"text-white/60 hover:text-[#39FF14]\" data-kid=\"1-2-1-2-5\" data-name=\"analyze navigation link\" href=\"#\">\n                    <i class=\"ti ti-analyze text-2xl\" data-kid=\"1-2-1-2-5-1\" data-name=\"analyze icon\">\n                    </i>\n                </a>\n                <a class=\"text-white/60 hover:text-[#39FF14]\" data-kid=\"1-2-1-2-6\" data-name=\"report navigation link\" href=\"#\">\n                    <i class=\"ti ti-report-analytics text-2xl\" data-kid=\"1-2-1-2-6-1\" data-name=\"report icon\">\n                    </i>\n                </a>\n            </nav>\n            <div class=\"mt-auto flex flex-col gap-6 items-center pb-4\" data-kid=\"1-2-1-3\" data-name=\"footer navigation container\">\n                <a class=\"text-white/20 hover:text-white\" data-kid=\"1-2-1-3-1\" data-name=\"settings link\" href=\"#\">\n                    <i class=\"ti ti-settings text-2xl\" data-kid=\"1-2-1-3-1-1\" data-name=\"settings icon\">\n                    </i>\n                </a>\n                <div class=\"w-10 h-10 bg-black border border-[#39FF14]/30 flex flex-col items-center justify-center\" data-kid=\"1-2-1-3-2\" data-name=\"operator ID badge\">\n                    <span class=\"text-[8px] font-mono text-[#39FF14] font-bold\" data-kid=\"1-2-1-3-2-1\" data-name=\"operator ID label\">\n                        ID\n                    </span>\n                    <span class=\"text-[10px] font-mono text-white leading-none font-bold\" data-kid=\"1-2-1-3-2-2\" data-name=\"operator ID value\">\n                        OPS-01\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <!-- Main Workspace -->\n        <main class=\"flex-grow flex flex-col min-w-0\" data-kid=\"1-2-2\" data-name=\"main workspace container\">\n            <!-- Header -->\n            <header class=\"h-[64px] border-b border-white/5 bg-[#111111] flex items-center px-8 justify-between z-40\" data-kid=\"1-2-2-1\" data-name=\"workspace header\">\n                <div class=\"flex items-center gap-6\" data-kid=\"1-2-2-1-1\" data-name=\"live source status container\">\n                    <div class=\"flex flex-col\" data-kid=\"1-2-2-1-1-1\" data-name=\"live source labels\">\n                        <span class=\"text-[10px] font-mono text-white/40 tracking-wider uppercase\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"live feed description\">\n                            Live Feed Source\n                        </span>\n                        <span class=\"font-space text-sm font-medium tracking-wide\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"live source name\">\n                            SAVANNA PERIMETER / CAM 04\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 bg-[#1A1A1A] px-3 py-1 border border-white/5\" data-kid=\"1-2-2-1-1-2\" data-name=\"online status indicator\">\n                        <div class=\"w-1.5 h-1.5 bg-[#39FF14] rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"status light\" data-reason=\"opacity pulsed by GSAP script\" id=\"live-indicator\">\n                        </div>\n                        <span class=\"text-[10px] font-mono text-[#39FF14] tracking-widest\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"status text\">\n                            ONLINE\n                        </span>\n                        <span class=\"text-[8px] font-mono text-white/30 tracking-[0.2em] ml-2 animate-pulse\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"scanning status text\">\n                            SCANNING...\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-8\" data-kid=\"1-2-2-1-2\" data-name=\"header action container\">\n                    <div class=\"flex flex-col items-end\" data-kid=\"1-2-2-1-2-1\" data-name=\"system time container\">\n                        <span class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"system time label\">\n                            System Time (UTC)\n                        </span>\n                        <span class=\"font-mono text-sm\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"system time value\" data-reason=\"text updated every 100ms by JS clock function\" id=\"utc-clock\">\n                            14:23:45.02\n                        </span>\n                    </div>\n                    <div class=\"h-8 w-[1px] bg-white/10\" data-kid=\"1-2-2-1-2-2\" data-name=\"header separator\">\n                    </div>\n                    <div class=\"border border-white/20 px-3 py-1 flex items-center gap-2 cursor-help\" data-kid=\"1-2-2-1-2-3\" data-name=\"hotkeys shortcut badge\">\n                        <span class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"hotkeys label\">\n                            Hotkeys\n                        </span>\n                        <span class=\"text-[10px] font-mono bg-[#39FF14] text-black px-1 rounded-xs font-bold\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"hotkey shortcut value\">\n                            Shift + U\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <!-- Workspace Columns -->\n            <div class=\"flex-grow grid grid-cols-[330px_1fr_330px] min-h-0 bg-[#0e0e0e]\" data-kid=\"1-2-2-2\" data-name=\"workspace columns container\">\n                <!-- Left: Input Queue -->\n                <section class=\"border-r border-white/5 flex flex-col min-h-0\" data-kid=\"1-2-2-2-1\" data-name=\"input queue section\">\n                    <div class=\"p-6 border-b border-white/5 flex justify-between items-center\" data-kid=\"1-2-2-2-1-1\" data-name=\"queue header container\">\n                        <h2 class=\"font-space text-xs tracking-[0.2em] text-[#39FF14]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"queue section title\">\n                            INPUT QUEUE\n                        </h2>\n                        <span class=\"text-[10px] font-mono text-white/30\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"pending items count\">\n                            03 PENDING\n                        </span>\n                    </div>\n                    <div class=\"p-6 flex flex-col gap-6 overflow-y-auto flex-grow scrollbar-hide\" data-kid=\"1-2-2-2-1-2\" data-name=\"queue content container\">\n                        <!-- Tactical Upload Dropzone -->\n                        <div class=\"relative bg-white/[0.02] p-8 text-center group cursor-pointer hover:bg-[#39FF14]/5 transition-colors border border-white/5\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"upload dropzone container\">\n                            <div class=\"bracket-corner top-0 left-0 border-r-0 border-b-0\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"top-left bracket\">\n                            </div>\n                            <div class=\"bracket-corner top-0 right-0 border-l-0 border-b-0\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"top-right bracket\">\n                            </div>\n                            <div class=\"bracket-corner bottom-0 left-0 border-r-0 border-t-0\" data-kid=\"1-2-2-2-1-2-1-3\" data-name=\"bottom-left bracket\">\n                            </div>\n                            <div class=\"bracket-corner bottom-0 right-0 border-l-0 border-t-0\" data-kid=\"1-2-2-2-1-2-1-4\" data-name=\"bottom-right bracket\">\n                            </div>\n                            <i class=\"ti ti-square-plus text-[#39FF14] text-3xl mb-4 block group-hover:scale-110 transition-transform\" data-kid=\"1-2-2-2-1-2-1-5\" data-name=\"upload icon\">\n                            </i>\n                            <p class=\"font-space text-[11px] tracking-[0.2em] mb-1 font-bold\" data-kid=\"1-2-2-2-1-2-1-6\" data-name=\"dropzone instruction text\">\n                                DROP DATASET FILES\n                            </p>\n                            <p class=\"text-[9px] font-mono text-white/40\" data-kid=\"1-2-2-2-1-2-1-7\" data-name=\"file type info text\">\n                                SUPPORTS: RAW, NIGHT, THERMAL, IR\n                            </p>\n                            <button class=\"mt-4 w-full py-2 bg-transparent border border-[#39FF14]/40 text-[#39FF14] font-space text-[10px] tracking-widest hover:bg-[#39FF14] hover:text-black transition-colors uppercase\" data-kid=\"1-2-2-2-1-2-1-8\" data-name=\"browse folder button\">\n                                Browse Folder\n                            </button>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"queue items list\" id=\"queue-container\">\n                            <div class=\"ticket-card p-4 queue-item\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"active processing ticket card\">\n                                <div class=\"flex justify-between items-start mb-4\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"ticket header\">\n                                    <div class=\"max-w-[180px]\" data-kid=\"1-2-2-2-1-2-2-1-1-1\" data-name=\"ticket details container\">\n                                        <p class=\"font-space text-[11px] font-bold truncate\" data-kid=\"1-2-2-2-1-2-2-1-1-1-1\" data-name=\"file name\">\n                                            FEED_NORTH_T7.JPG\n                                        </p>\n                                        <p class=\"text-[9px] font-mono text-white/40 mt-0.5\" data-kid=\"1-2-2-2-1-2-2-1-1-1-2\" data-name=\"file metadata\">\n                                            SIZE: 6.4MB | TYPE: DAYLIGHT\n                                        </p>\n                                    </div>\n                                    <div class=\"text-right\" data-kid=\"1-2-2-2-1-2-2-1-1-2\" data-name=\"status container\">\n                                        <span class=\"text-[9px] font-mono text-[#FF4F00] font-bold block\" data-kid=\"1-2-2-2-1-2-2-1-1-2-1\" data-name=\"processing status text\">\n                                            PROCESSING\n                                        </span>\n                                        <span class=\"text-[9px] font-mono text-white/30 uppercase\" data-kid=\"1-2-2-2-1-2-2-1-1-2-2\" data-name=\"stage status text\">\n                                            Stage 03\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"h-1 bg-[#39FF14]/20 mb-2 overflow-hidden\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"progress track\">\n                                    <div class=\"h-full bg-[#39FF14]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2-1-2-1\" data-name=\"progress bar fill\" data-reason=\"width animated/reinitialized by GSAP\" id=\"progress-bar-1\" style=\"width: 45%;\">\n                                    </div>\n                                </div>\n                                <div class=\"flex justify-between text-[8px] font-mono text-white/30 uppercase\" data-kid=\"1-2-2-2-1-2-2-1-3\" data-name=\"progress metadata\">\n                                    <span data-kid=\"1-2-2-2-1-2-2-1-3-1\" data-name=\"analysis type label\">\n                                        Segmentation Analysis\n                                    </span>\n                                    <span data-kid=\"1-2-2-2-1-2-2-1-3-2\" data-name=\"percentage label\">\n                                        45%\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"ticket-card p-4 opacity-50 queue-item\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"waiting ticket card\">\n                                <div class=\"flex justify-between items-start mb-4\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-name=\"ticket header\">\n                                    <div data-kid=\"1-2-2-2-1-2-2-2-1-1\" data-name=\"ticket details container\">\n                                        <p class=\"font-space text-[11px] font-bold truncate\" data-kid=\"1-2-2-2-1-2-2-2-1-1-1\" data-name=\"file name\">\n                                            THERMAL_TEST_B02.PNG\n                                        </p>\n                                        <p class=\"text-[9px] font-mono text-white/40 mt-0.5\" data-kid=\"1-2-2-2-1-2-2-2-1-1-2\" data-name=\"file metadata\">\n                                            SIZE: 1.2MB | TYPE: THERMAL\n                                        </p>\n                                    </div>\n                                    <div class=\"text-right\" data-kid=\"1-2-2-2-1-2-2-2-1-2\" data-name=\"status container\">\n                                        <span class=\"text-[9px] font-mono text-white/40 uppercase block\" data-kid=\"1-2-2-2-1-2-2-2-1-2-1\" data-name=\"waiting status text\">\n                                            Waiting\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"flex gap-0.5 w-full\" data-kid=\"1-2-2-2-1-2-2-2-2\" data-name=\"pending status progress bar\">\n                                    <div class=\"h-1 bg-white/5 flex-grow\" data-kid=\"1-2-2-2-1-2-2-2-2-1\">\n                                    </div>\n                                    <div class=\"h-1 bg-white/5 flex-grow\" data-kid=\"1-2-2-2-1-2-2-2-2-2\">\n                                    </div>\n                                    <div class=\"h-1 bg-white/5 flex-grow\" data-kid=\"1-2-2-2-1-2-2-2-2-3\">\n                                    </div>\n                                    <div class=\"h-1 bg-white/5 flex-grow\" data-kid=\"1-2-2-2-1-2-2-2-2-4\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"p-6 border-t border-white/5\" data-kid=\"1-2-2-2-1-3\" data-name=\"import dataset container\">\n                        <button class=\"w-full py-3 bg-[#1A1A1A] border border-white/10 text-white/70 font-space text-[10px] tracking-widest hover:border-[#39FF14]/50 hover:text-white transition-all uppercase\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"import dataset button\">\n                            Import FLIR Dataset\n                        </button>\n                    </div>\n                </section>\n                <!-- Center: Viewport -->\n                <section class=\"flex flex-col relative overflow-hidden bg-black\" data-kid=\"1-2-2-2-2\" data-name=\"center viewport container\">\n                    <div class=\"absolute inset-0 thermal-grid pointer-events-none opacity-40\" data-kid=\"1-2-2-2-2-1\" data-name=\"thermal background grid\">\n                    </div>\n                    <div class=\"absolute inset-0 vignette z-10\" data-kid=\"1-2-2-2-2-2\" data-name=\"vignette overlay\">\n                    </div>\n                    <div class=\"scanline\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-3\" data-name=\"scanline animation\" data-reason=\"top position animated vertically by GSAP\" id=\"scanline\">\n                    </div>\n                    <div class=\"flex-grow flex items-center justify-center relative\" data-kid=\"1-2-2-2-2-4\" data-name=\"view content area\">\n                        <div class=\"corner-bracket cb-tl\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"top-left viewport bracket\">\n                        </div>\n                        <div class=\"corner-bracket cb-tr\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"top-right viewport bracket\">\n                        </div>\n                        <div class=\"corner-bracket cb-bl\" data-kid=\"1-2-2-2-2-4-3\" data-name=\"bottom-left viewport bracket\">\n                        </div>\n                        <div class=\"corner-bracket cb-br\" data-kid=\"1-2-2-2-2-4-4\" data-name=\"bottom-right viewport bracket\">\n                        </div>\n                        <!-- HUD Elements -->\n                        <div class=\"absolute top-8 left-8 flex flex-col gap-2 font-mono text-[9px] tracking-wider text-[#39FF14] z-20\" data-kid=\"1-2-2-2-2-4-5\" data-name=\"left HUD elements\">\n                            <div class=\"bg-black/80 px-2 py-1 border-l border-[#39FF14]/50\" data-kid=\"1-2-2-2-2-4-5-1\" data-name=\"range info\">\n                                RANGE:\n                                <span class=\"text-white\" data-kid=\"1-2-2-2-2-4-5-1-1\" data-name=\"range value\">\n                                    --- MT\n                                </span>\n                            </div>\n                            <div class=\"bg-black/80 px-2 py-1 border-l border-[#39FF14]/50\" data-kid=\"1-2-2-2-2-4-5-2\" data-name=\"elevation info\">\n                                ELEV:\n                                <span class=\"text-white\" data-kid=\"1-2-2-2-2-4-5-2-1\" data-name=\"elevation value\">\n                                    14.2°\n                                </span>\n                            </div>\n                            <div class=\"bg-black/80 px-2 py-1 border-l border-[#39FF14]/50\" data-kid=\"1-2-2-2-2-4-5-3\" data-name=\"azimuth info\">\n                                AZIM:\n                                <span class=\"text-white\" data-kid=\"1-2-2-2-2-4-5-3-1\" data-name=\"azimuth value\">\n                                    284.5°\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"absolute top-8 right-8 flex flex-col items-end gap-2 font-mono text-[9px] tracking-wider text-[#39FF14] z-20\" data-kid=\"1-2-2-2-2-4-6\" data-name=\"right HUD elements\">\n                            <div class=\"bg-black/80 px-2 py-1 border-r border-[#39FF14]/50\" data-kid=\"1-2-2-2-2-4-6-1\" data-name=\"zoom info\">\n                                ZOOM:\n                                <span class=\"text-white\" data-kid=\"1-2-2-2-2-4-6-1-1\" data-name=\"zoom value\">\n                                    1.0X\n                                </span>\n                            </div>\n     
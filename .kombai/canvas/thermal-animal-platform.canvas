              </div>\n                    </div>\n                </section>\n                <!-- Right: Inference Ledger -->\n                <section class=\"border-l border-white/5 bg-[#111111] flex flex-col min-h-0\" data-kid=\"1-2-2-2-3\" data-name=\"inference ledger section\">\n                    <div class=\"p-6 border-b border-white/5\" data-kid=\"1-2-2-2-3-1\" data-name=\"ledger header\">\n                        <h2 class=\"font-space text-xs tracking-[0.2em] text-[#39FF14]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"ledger title\">\n                            INFERENCE LEDGER\n                        </h2>\n                    </div>\n                    <div class=\"p-6 flex flex-col gap-8 overflow-y-auto flex-grow scrollbar-hide\" data-kid=\"1-2-2-2-3-2\" data-name=\"ledger content\">\n                        <div class=\"space-y-4\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"ledger telemetry list\">\n                            <div class=\"flex justify-between items-center border-b border-white/5 pb-2\" data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"list header\">\n                                <span class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"1-2-2-2-3-2-1-1-1\">\n                                    Sensors\n                                </span>\n                                <span class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"1-2-2-2-3-2-1-1-2\">\n                                    Status\n                                </span>\n                            </div>\n                            <div class=\"space-y-3 font-mono text-[11px]\" data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"telemetry data grid\">\n                                <div class=\"flex justify-between text-white/80\" data-kid=\"1-2-2-2-3-2-1-2-1\">\n                                    <span data-kid=\"1-2-2-2-3-2-1-2-1-1\">\n                                        INPUT TYPE\n                                    </span>\n                       
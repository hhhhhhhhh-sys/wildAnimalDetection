        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@10..48,600;10..48,700&family=Source+Sans+3:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  .app-shell{min-height:100vh;background:#F4F0EC;color:#1F305E;padding:32px;font-family:'Source Sans 3',sans-serif}\n  .wrap{max-width:1180px;margin:0 auto}\n  .topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;border-bottom:3px solid #1F305E;padding-bottom:20px}\n  .eyebrow{margin:0 0 12px;text-transform:uppercase;letter-spacing:.17em;font-size:11px;font-weight:700;color:rgba(31,48,94,.58)}\n  .eyebrow-line{display:flex;align-items:center;gap:10px;margin-bottom:12px;text-transform:uppercase;letter-spacing:.18em;font-size:11px;font-weight:700;color:rgba(31,48,94,.65)}\n  .orange-dot{display:inline-block;width:10px;height:10px;background:#FE5A1D;flex:none}\n  .mode-tag{border:1px solid rgba(31,48,94,.28);padding:5px 8px;font-size:10px;letter-spacing:.12em}\n  h1,h2,h3,p{margin:0}\n  h1,h2,h3{font-family:'Bricolage Grotesque',sans-serif}\n  h1{font-size:60px;line-height:.94;letter-spacing:-.05em}\n  h3{font-size:22px;line-height:1.05}\n  .subtitle{margin-top:12px;font-size:18px;font-weight:500;color:rgba(31,48,94,.7)}\n  .model-state{display:flex;align-items:center;gap:12px;border-left:3px solid #1F305E;padding-left:16px;font-size:14px;font-weight:600}\n  .state-label{margin-bottom:3px;text-transform:uppercase;letter-spacing:.14em;font-size:10px;color:rgba(31,48,94,.55)}\n  .dashboard{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(320px,.85fr);gap:24px;margin-top:28px}\n  .stack{display:flex;flex-direction:column;gap:24px}\n  .panel{border:3px solid #1F305E;background:#fff;box-shadow:7px 7px 0 #1F305E}\n  .panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:3px solid #1F305E;padding:17px 22px}\n  .panel-body{padding:24px}\n  .sample-note{display:flex;align-items:center;gap:9px;color:rgba(31,48,94,.68);font-size:12px;font-weight:600}\n  .preview-frame{position:relative;display:flex;min-height:480px;align-items:center;justify-content:center;overflow:hidden;border:2px solid #1F305E;background:#EEE9E3}\n  .preview-frame img{width:100%;height:100%;max-height:520px;object-fit:contain;display:block}\n  .bbox{position:absolute;left:24%;top:22%;width:51%;height:55%;border:4px solid #FE5A1D;pointer-events:none}\n  .bbox-label{position:absolute;left:-4px;top:-35px;background:#FE5A1D;color:#fff;padding:6px 12px;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:700}\n  .bbox-corner{position:absolute;right:-4px;bottom:-4px;width:12px;height:12px;background:#FE5A1D}\n  .input-badge{position:absolute;bottom:12px;left:12px;border:1px solid rgba(31,48,94,.24);background:rgba(255,255,255,.92);padding:6px 10px;color:rgba(31,48,94,.7);font-size:11px;font-weight:600}\n  .sample-alert{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:16px;border-left:3px solid #FE5A1D;background:#FFF4EE;padding:12px 16px;color:rgba(31,48,94,.82);font-size:14px;font-weight:600}\n  .sample-alert .result-label{color:#FE5A1D;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:700;white-space:nowrap}\n  .upload-panel{padding:22px}\n  .upload-row{display:flex;align-items:flex-end;justify-content:space-between;gap:18px}\n  .helper{margin-top:5px;color:rgba(31,48,94,.65);font-size:14px}\n  .choose-button,.run-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;border:2px solid #1F305E;padding:11px 16px;font-size:14px;font-weight:700;text-decoration:none}\n  .choose-button{background:#F4F0EC;color:#1F305E}\n  .choose-button:hover,.run-button:hover{background:#FE5A1D;color:#fff}\n  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n  .upload-meta{display:flex;align-items:center;justify-content:space-between;gap:18px;border-top:2px solid rgba(31,48,94,.15);margin-top:19px;padding-top:16px}\n  .file-name{display:flex;align-items:center;gap:9px;color:rgba(31,48,94,.68);font-size:14px}\n  .run-button{background:#1F305E;color:#fff}\n  .status-card{border:3px solid #1F305E;background:#FE5A1D;color:#fff;padding:24px;box-shadow:7px 7px 0 #1F305E}\n  .status-card .eyebrow{color:rgba(255,255,255,.75)}\n  .status-main{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-top:27px}\n  .status-main h3{font-size:43px;letter-spacing:-.045em;color:#fff}\n  .status-main p{max-width:280px;margin-top:13px;color:rgba(255,255,255,.92);font-size:17px;font-weight:600;line-height:1.3}\n  .alert-icon{display:flex;height:48px;width:48px;flex:none;align-items:center;justify-content:center;border:2px solid #fff;font-size:24px}\n  .status-details{display:grid;grid-template-columns:1fr 1fr;gap:12px;border-top:2px solid rgba(255,255,255,.35);margin-top:30px;padding-top:16px}\n  .detail-label{color:rgba(255,255,255,.72);text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:700}\n  .detail-value{margin-top:4px;font-size:27px;font-weight:700}\n  .metrics-head{border-bottom:3px solid #1F305E;padding:17px 22px}\n  .metrics-list{padding:4px 22px}\n  .metric{display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid rgba(31,48,94,.15);padding:16px 0}\n  .metric:last-child{border-bottom:0}\n  .metric dt{color:rgba(31,48,94,.7);font-size:15px;font-weight:600}\n  .metric dd{font-size:18px;font-weight:700;white-space:nowrap}\n  .metric-note{border-top:2px solid rgba(31,48,94,.15);background:#F4F0EC;padding:15px 22px;color:rgba(31,48,94,.65);font-size:12px;line-height:1.6}\n  .footer{display:flex;align-items:center;justify-content:space-between;gap:16px;border-top:2px solid rgba(31,48,94,.25);margin-top:32px;padding-top:16px;color:rgba(31,48,94,.56);font-size:12px;font-weight:600}\n  @media(max-width:850px){.app-shell{padding:20px}.topbar{align-items:flex-start;flex-direction:column}.dashboard{grid-template-columns:1fr}.preview-frame{min-height:360px}h1{font-size:48px}.upload-row,.upload-meta,.sample-alert,.footer{align-items:flex-start;flex-direction:column}.choose-button,.run-button{width:100%}}\n</style>\n<div class=\"app-shell\" data-kid=\"1\">\n    <header class=\"wrap topbar\" data-kid=\"1-1\">\n        <div data-kid=\"1-1-1\">\n            <div class=\"eyebrow-line\" data-kid=\"1-1-1-1\">\n                <span class=\"orange-dot\" data-kid=\"1-1-1-1-1\">\n                </span>\n                Computer vision showcase\n                <span class=\"mode-tag\" data-kid=\"1-1-1-1-2\">\n                    Demo mode\n                </span>\n            </div>\n            <h1 data-kid=\"1-1-1-2\">\n                Animal Detector\n            </h1>\n            <p class=\"subtitle\" data-kid=\"1-1-1-3\">\n                Custom NumPy CNN Model Validation\n            </p>\n        </div>\n        <div class=\"model-state\" data-kid=\"1-1-2\">\n            <span class=\"orange-dot\" data-kid=\"1-1-2-1\">\n            </span>\n            <div data-kid=\"1-1-2-2\">\n                <p class=\"state-label\" data-kid=\"1-1-2-2-1\">\n                    Model status\n                </p>\n                <p data-dynamic=\"true\" data-kid=\"1-1-2-2-2\" data-name=\"model status display text\" data-reason=\"text content updated to indicate status\">\n                    Ready for an image\n                </p>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Animal detection workspace\" class=\"wrap dashboard\" data-kid=\"1-2\">\n        <section aria-label=\"Image input and preview\" class=\"stack\" data-kid=\"1-2-1\">\n            <article class=\"panel\" data-kid=\"1-2-1-1\">\n                <div class=\"panel-head\" data-kid=\"1-2-1-1-1\">\n                    <div data-kid=\"1-2-1-1-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-1-1-1-1-1\">\n                            01 / Preview\n                        </p>\n                        <h3 data-kid=\"1-2-1-1-1-1-2\">\n                            Detection canvas\n                        </h3>\n                    </div>\n                    <span class=\"sample-note\" data-kid=\"1-2-1-1-1-2\">\n                        <span class=\"orange-dot\" data-kid=\"1-2-1-1-1-2-1\">\n                        </span>\n                        Sample output\n                    </span>\n                </div>\n                <div class=\"panel-body\" data-kid=\"1-2-1-1-2\">\n                    <div aria-label=\"Annotated animal image preview\" class=\"preview-frame\" data-kid=\"1-2-1-1-2-1\">\n                        <img alt=\"Sample image with a detected dog highlighted\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"uploaded image preview\" data-reason=\"image src replaced by script on user upload\" decoding=\"async\" id=\"preview-image\" loading=\"lazy\" src=\"/api/local/images/animal_detector/samples/test_00005_out.png\"/>\n                        <div aria-label=\"Bounding box around detected dog\" class=\"bbox\" data-kid=\"1-2-1-1-2-1-2\">\n                            <span class=\"bbox-label\" data-kid=\"1-2-1-1-2-1-2-1\">\n                                dog 93%\n                            </span>\n                            <span class=\"bbox-corner\" data-kid=\"1-2-1-1-2-1-2-2\">\n                            </span>\n                        </div>\n                        <span class=\"input-badge\" data-kid=\"1-2-1-1-2-1-3\">\n                            64 × 64 model input\n                        </span>\n                    </div>\n                    <div class=\"sample-alert\" data-kid=\"1-2-1-1-2-2\">\n                        <span data-kid=\"1-2-1-1-2-2-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-1-1-2-2-1-1\">\n                            </i>\n                            Real upload replaces this sample preview.\n                        </span>\n                        <span class=\"result-label\" data-kid=\"1-2-1-1-2-2-2\">\n                            Result shown\n                        </span>\n                    </div>\n                </div>\n            </article>\n            <article aria-labelledby=\"upload-title\" class=\"panel upload-panel\" data-kid=\"1-2-1-2\">\n                <div class=\"upload-row\" data-kid=\"1-2-1-2-1\">\n                    <div data-kid=\"1-2-1-2-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-1-2-1-1-1\">\n                            02 / Input\n                        </p>\n                        <h3 data-kid=\"1-2-1-2-1-1-2\" id=\"upload-title\">\n                            Upload an image\n                        </h3>\n                        <p class=\"helper\" data-kid=\"1-2-1-2-1-1-3\">\n                            JPG, PNG, or WEBP · one animal per image\n                        </p>\n                    </div>\n                    <label class=\"choose-button\" data-kid=\"1-2-1-2-1-2\" for=\"image-upload\">\n                        <i aria-hidden=\"true\" class=\"ti ti-upload\" data-kid=\"1-2-1-2-1-2-1\">\n                        </i>\n                        Choose image\n                    </label>\n                    <input accept=\"image/png,image/jpeg,image/webp\" aria-describedby=\"selected-file\" class=\"sr-only\" data-kid=\"1-2-1-2-1-3\" id=\"image-upload\" type=\"file\"/>\n                </div>\n                <div class=\"upload-meta\" data-kid=\"1-2-1-2-2\">\n                    <p class=\"file-name\" data-kid=\"1-2-1-2-2-1\" id=\"selected-file\">\n                        <i aria-hidden=\"true\" class=\"ti ti-file-image\" data-kid=\"1-2-1-2-2-1-1\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"uploaded filename status text\" data-reason=\"text content updated to indicate loaded file\">\n                            test_00005_out.png · sample loaded\n                        </span>\n                    </p>\n                    <button class=\"run-button\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2\" data-name=\"detection trigger button\" data-reason=\"content replaced by loading indicator on click\" id=\"run-detection\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-scan\" data-kid=\"1-2-1-2-2-2-1\">\n                        </i>\n                        Run detection\n                    </button>\n                </div>\n            </article>\n        </section>\n        <aside aria-label=\"Detection result and model metrics\" class=\"stack\" data-kid=\"1-2-2\">\n            <article aria-live=\"polite\" class=\"status-card\" data-dynamic=\"true\" data-kid=\"1-2-2-1\" data-name=\"detection result status card\" data-reason=\"content and visibility updated by detection process\" role=\"status\">\n                <p class=\"eyebrow\" data-kid=\"1-2-2-1-1\">\n                    03 / Detection result\n                </p>\n                <div class=\"status-main\" data-kid=\"1-2-2-1-2\">\n                    <div data-kid=\"1-2-2-1-2-1\">\n                        <h3 data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"detection status headline\" data-reason=\"text content updated to reflect detection result\">\n                            Animal found\n                        </h3>\n                        <p data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"detection status alert message\" data-reason=\"text content updated to reflect detection result\">\n                            ALERT: dog detected in the uploaded image.\n                        </p>\n                    </div>\n                    <span aria-hidden=\"true\" class=\"alert-icon\" data-kid=\"1-2-2-1-2-2\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"1-2-2-1-2-2-1\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"status-details\" data-kid=\"1-2-2-1-3\">\n                    <div data-kid=\"1-2-2-1-3-1\">\n                        <p class=\"detail-label\" data-kid=\"1-2-2-1-3-1-1\">\n                            Class\n                        </p>\n                        <p class=\"detail-value\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"detected class label\" data-reason=\"text content updated based on detection result\">\n                            Dog\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-1-3-2\">\n                        <p class=\"detail-label\" data-kid=\"1-2-2-1-3-2-1\">\n                            Confidence\n                        </p>\n                        <p class=\"detail-value\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"confidence score label\" data-reason=\"text content updated based on detection result\">\n                            93.0%\n                        </p>\n                    </div>\n                </div>\n            </article>\n            <article aria-labelledby=\"metrics-title\" class=\"panel\" data-kid=\"1-2-2-2\">\n                <div class=\"metrics-head\" data-kid=\"1-2-2-2-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-2-2-1-1\">\n                        04 / Evaluation\n                    </p>\n                    <h3 data-kid=\"1-2-2-2-1-2\" id=\"metrics-title\">\n                        Model capability ledger\n                    </h3>\n                </div>\n                <dl class=\"metrics-list\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"metric\" data-kid=\"1-2-2-2-2-1\">\n                        <dt data-kid=\"1-2-2-2-2-1-1\">\n                            Objectness accuracy\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-2-1-2\">\n                            86.7%\n                        </dd>\n                    </div>\n                    <div class=\"metric\" data-kid=\"1-2-2-2-2-2\">\n                        <dt data-kid=\"1-2-2-2-2-2-1\">\n                            Precision / Recall\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-2-2-2\">\n                            89.1% / 96.1%\n                        </dd>\n                    </div>\n                    <div class=\"metric\" data-kid=\"1-2-2-2-2-3\">\n                        <dt data-kid=\"1-2-2-2-2-3-1\">\n                            Classification accuracy\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-2-3-2\">\n                            66.7%\n                        </dd>\n                    </div>\n                    <div class=\"metric\" data-kid=\"1-2-2-2-2-4\">\n                        <dt data-kid=\"1-2-2-2-2-4-1\">\n                            Mean IoU\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-2-4-2\">\n                            0.644\n                        </dd>\n                    </div>\n                </dl>\n                <div class=\"metric-note\" data-kid=\"1-2-2-2-3\">\n                    Measured on the held-out synthetic test set. Use real photos for a meaningful field evaluation.\n                </div>\n            </article>\n        </aside>\n    </main>\n    <footer class=\"wrap footer\" data-kid=\"1-3\">\n        <span data-kid=\"1-3-1\">\n            NumPy CNN · 4 classes · bounding box + alert\n        </span>\n        <span data-kid=\"1-3-2\">\n            Built for mentor review\n        </span>\n    </footer>\n</div>\n<script>\n    const upload=document.getElementById('image-upload');const fileText=document.querySelector('#selected-file span');const preview=document.getElementById('preview-image');const runButton=document.getElementById('run-detection');\n  upload?.addEventListener('change',()=>{const file=upload.files&&upload.files[0];if(!file)return;fileText.textContent=file.name+' · ready to analyze';preview.src=URL.createObjectURL(file);preview.alt='Uploaded image ready for animal detection';});\n  runButton?.addEventListener('click',()=>{runButton.innerHTML='<i class=\"ti ti-loader-2\" aria-hidden=\"true\"></i> Detection queued';setTimeout(()=>{runButton.innerHTML='<i class=\"ti ti-scan\" aria-hidden=\"true\"></i> Run detection';},1400);});\n</script>\n",
      "comments": [],
      "created": "2026-07-30T16:23:35.430893+00:00",
      "modified": "2026-07-30T16:25:36.367071+00:00",
      "id": "var_caae96799c71"
    },
    "var_a0f68237dda9": {
      "type": "variant",
      "label": "Hacker Console Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#0f1211] px-5 py-5 text-[#e8eee9] sm:px-8 sm:py-7\" data-kid=\"1\" style=\"font-family:'Space Grotesk', sans-serif;\">\n    <div class=\"mx-auto max-w-[1180px]\" data-kid=\"1-1\">\n        <header class=\"flex flex-col gap-4 border-b border-[#2a332e] pb-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\">\n                <div aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center border border-[#3a493f] bg-[#18201b] text-lg text-[#6fe28b]\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"ti ti-terminal-2\" data-kid=\"1-1-1-1-1-1\" style=\"width:20px;height:20px;\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2-1\">\n                        <h1 class=\"text-lg font-semibold tracking-[-0.02em] text-[#f1f5f2]\" data-kid=\"1-1-1-1-2-1-1\">\n                            inference.py\n                        </h1>\n                        <span class=\"border border-[#334037] px-2 py-0.5 text-[10px] uppercase tracking-[0.14em] text-[#92a298]\" data-kid=\"1-1-1-1-2-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            NumPy CNN\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-xs text-[#829188]\" data-kid=\"1-1-1-1-2-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                        Animal Detection Sandbox\n                        <span class=\"text-[#4f6256]\" data-kid=\"1-1-1-1-2-2-1\">\n                            /\n                        </span>\n                        single image inference\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2 self-start border border-[#31573b] bg-[#132218] px-3 py-2 text-[11px] font-medium tracking-[0.12em] text-[#7ee898] sm:self-auto\" data-kid=\"1-1-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                <span class=\"h-2 w-2 rounded-full bg-[#68dc83]\" data-kid=\"1-1-1-2-1\">\n                </span>\n                STATUS: READY\n            </div>\n        </header>\n        <main class=\"grid gap-5 pt-6 lg:grid-cols-[0.86fr_1.14fr]\" data-kid=\"1-1-2\">\n            <section class=\"space-y-5\" data-kid=\"1-1-2-1\">\n                <div class=\"border border-[#2a332e] bg-[#171c19] p-5 sm:p-6\" data-kid=\"1-1-2-1-1\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-2-1-1-1\">\n                        <div data-kid=\"1-1-2-1-1-1-1\">\n                            <p class=\"text-[11px] font-medium uppercase tracking-[0.18em] text-[#6fe28b]\" data-kid=\"1-1-2-1-1-1-1-1\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                Input image\n                            </p>\n                            <h2 class=\"mt-2 text-2xl font-semibold tracking-[-0.03em] text-[#f0f4f0]\" data-kid=\"1-1-2-1-1-1-1-2\">\n                                Run a detection\n                            </h2>\n                            <p class=\"mt-2 max-w-sm text-sm leading-6 text-[#91a097]\" data-kid=\"1-1-2-1-1-1-1-3\">\n                                Upload one image and let the CNN check for an animal, classify the species, and locate it.\n                            </p>\n                        </div>\n                        <span class=\"hidden border border-[#303b34] px-2 py-1 text-[10px] text-[#829188] sm:inline-block\" data-kid=\"1-1-2-1-1-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            64 × 64 input\n                        </span>\n                    </div>\n                    <label class=\"mt-6 flex min-h-[190px] cursor-pointer flex-col items-center justify-center border border-dashed border-[#4a5a50] bg-[#111613] px-6 text-center hover:border-[#72dd8e]\" data-kid=\"1-1-2-1-1-2\" for=\"image-upload\">\n                        <input accept=\"image/png,image/jpeg,image/webp\" class=\"sr-only\" data-kid=\"1-1-2-1-1-2-1\" id=\"image-upload\" type=\"file\"/>\n                        <span aria-hidden=\"true\" class=\"flex h-12 w-12 items-center justify-center border border-[#34503b] bg-[#17251a] text-2xl text-[#73e391]\" data-kid=\"1-1-2-1-1-2-2\">\n                            <i class=\"ti ti-cloud-upload\" data-kid=\"1-1-2-1-1-2-2-1\" style=\"width:24px;height:24px;\">\n                            </i>\n                        </span>\n                        <span class=\"mt-4 text-sm font-medium text-[#d9e3db]\" data-kid=\"1-1-2-1-1-2-3\">\n                            Drop an image here or browse\n                        </span>\n                        <span class=\"mt-2 text-xs text-[#78877d]\" data-kid=\"1-1-2-1-1-2-4\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            PNG, JPG, or WEBP · max 10 MB\n                        </span>\n                    </label>\n                    <div class=\"mt-4 flex items-center justify-between gap-3 border border-[#2e3a32] bg-[#121713] px-3 py-2.5\" data-kid=\"1-1-2-1-1-3\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-1-1-3-1\">\n                            <span aria-hidden=\"true\" class=\"flex h-7 w-7 shrink-0 items-center justify-center bg-[#1b3822] text-[#6fe28b] text-base\" data-kid=\"1-1-2-1-1-3-1-1\">\n                                <i class=\"ti ti-photo\" data-kid=\"1-1-2-1-1-3-1-1-1\" style=\"width:16px;height:16px;\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-3-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                <p class=\"truncate text-xs font-medium text-[#dce6de]\" data-kid=\"1-1-2-1-1-3-1-2-1\">\n                                    test_00005.png\n                                </p>\n                                <p class=\"mt-0.5 text-[10px] text-[#75847a]\" data-kid=\"1-1-2-1-1-3-1-2-2\">\n                                    ready for inference · 128 KB\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"shrink-0 border border-[#68dc83] bg-[#68dc83] px-3 py-2 text-xs font-semibold text-[#102016] hover:bg-[#8bf2a4]\" data-kid=\"1-1-2-1-1-3-2\" style=\"font-family:'IBM Plex Mono', monospace;\" type=\"button\">\n                            Run inference\n                        </button>\n                    </div>\n                </div>\n                <div class=\"border border-[#2a332e] bg-[#141916] p-5\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-1-2-1\">\n                        <h2 class=\"text-sm font-semibold text-[#e4ece5]\" data-kid=\"1-1-2-1-2-1-1\">\n                            Execution trace\n                        </h2>\n                        <span class=\"text-[10px] uppercase tracking-[0.16em] text-[#688172]\" data-kid=\"1-1-2-1-2-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            stdout\n                        </span>\n                    </div>\n                    <div class=\"mt-4 space-y-3 border-l border-[#3a4b40] pl-4\" data-kid=\"1-1-2-1-2-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                        <div class=\"relative text-xs text-[#9aa99e]\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"execution trace step 1 indicator\">\n                            <span class=\"absolute -left-[21px] top-1 h-2 w-2 rounded-full bg-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"execution step 1 bullet\">\n                            </span>\n                            <span class=\"text-[#587160]\" data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"execution step 1 timestamp\">\n                                01\n                            </span>\n                            loaded image\n                            <span class=\"text-[#d9e5dc]\" data-kid=\"1-1-2-1-2-2-1-3\" data-name=\"execution step 1 message\">\n                                test_00005.png\n                            </span>\n                        </div>\n                        <div class=\"relative text-xs text-[#9aa99e]\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"execution trace step 2 indicator\">\n                            <span class=\"absolute -left-[21px] top-1 h-2 w-2 rounded-full bg-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"execution step 2 bullet\">\n                            </span>\n                            <span class=\"text-[#587160]\" data-kid=\"1-1-2-1-2-2-2-2\" data-name=\"execution step 2 timestamp\">\n                                02\n                            </span>\n                            resized to\n                            <span class=\"text-[#d9e5dc]\" data-kid=\"1-1-2-1-2-2-2-3\" data-name=\"execution step 2 message\">\n                                64 × 64\n                            </span>\n                        </div>\n                        <div class=\"relative text-xs text-[#9aa99e]\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"execution trace step 3 indicator\">\n                            <span class=\"absolute -left-[21px] top-1 h-2 w-2 rounded-full bg-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-3-1\" data-name=\"execution step 3 bullet\">\n                            </span>\n                            <span class=\"text-[#587160]\" data-kid=\"1-1-2-1-2-2-3-2\" data-name=\"execution step 3 timestamp\">\n                                03\n                            </span>\n                            forward pass complete\n                            <span class=\"text-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-3-3\" data-name=\"execution step 3 message\">\n                                0.18s\n                            </span>\n                        </div>\n                        <div class=\"relative text-xs text-[#9aa99e]\" data-kid=\"1-1-2-1-2-2-4\" data-name=\"execution trace step 4 indicator\">\n                            <span class=\"absolute -left-[21px] top-1 h-2 w-2 rounded-full bg-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-4-1\" data-name=\"execution step 4 bullet\">\n                            </span>\n                            <span class=\"text-[#587160]\" data-kid=\"1-1-2-1-2-2-4-2\" data-name=\"execution step 4 timestamp\">\n                                04\n                            </span>\n                            threshold\n                            <span class=\"text-[#d9e5dc]\" data-kid=\"1-1-2-1-2-2-4-3\" data-name=\"execution step 4 message part 1\">\n                                0.50\n                            </span>\n                            · objectness\n                            <span class=\"text-[#6fe28b]\" data-kid=\"1-1-2-1-2-2-4-4\" data-name=\"execution step 4 message part 2\">\n                                0.93\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"border border-[#2a332e] bg-[#171c19] px-5 py-4\" data-kid=\"1-1-2-1-3\">\n                    <div class=\"flex gap-3\" data-kid=\"1-1-2-1-3-1\">\n                        <span aria-hidden=\"true\" class=\"mt-0.5 text-base text-[#9dac9f]\" data-kid=\"1-1-2-1-3-1-1\">\n                            <i class=\"ti ti-info-circle\" data-kid=\"1-1-2-1-3-1-1-1\" style=\"width:17px;height:17px;\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-1-2-1-3-1-2\">\n                            <p class=\"text-xs font-medium text-[#d9e3db]\" data-kid=\"1-1-2-1-3-1-2-1\">\n                                No-animal interpretation\n                            </p>\n                            <p class=\"mt-1 text-xs leading-5 text-[#829188]\" data-kid=\"1-1-2-1-3-1-2-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                If objectness is below 0.50, the alert becomes “No animal detected” and the box remains hidden.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section class=\"space-y-5\" data-kid=\"1-1-2-2\">\n                <div class=\"border border-[#356241] bg-[#14241a] px-5 py-4 sm:px-6\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-2-2-1-1\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-1-2-2-1-1-1\">\n                            <span aria-hidden=\"true\" class=\"mt-0.5 flex h-8 w-8 items-center justify-center border border-[#40784e] bg-[#1c3822] text-[#75e893] text-base\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                <i class=\"ti ti-alert-circle\" data-kid=\"1-1-2-2-1-1-1-1-1\" style=\"width:18px;height:18px;\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-1-2-2-1-1-1-2\">\n                                <p class=\"text-[10px] uppercase tracking-[0.17em] text-[#77d88c]\" data-kid=\"1-1-2-2-1-1-1-2-1\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                    Detection result\n                                </p>\n                                <h2 class=\"mt-1 text-lg font-semibold text-[#eff8f0]\" data-kid=\"1-1-2-2-1-1-1-2-2\" data-name=\"detection result headline\">\n                                    ALERT: dog detected!\n                                </h2>\n                                <p class=\"mt-1 text-xs text-[#a8c9af]\" data-kid=\"1-1-2-2-1-1-1-2-3\" data-name=\"detection result meta details\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                    confidence 93.0% · animal_detected = true\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"border border-[#3f754b] bg-[#193020] px-2.5 py-1.5 text-[10px] font-medium uppercase tracking-[0.15em] text-[#80e79a]\" data-kid=\"1-1-2-2-1-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            positive match\n                        </span>\n                    </div>\n                </div>\n                <div class=\"border border-[#2a332e] bg-[#171c19] p-3 sm:p-4\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"mb-3 flex items-center justify-between px-1\" data-kid=\"1-1-2-2-2-1\">\n                        <div data-kid=\"1-1-2-2-2-1-1\">\n                            <p class=\"text-[10px] uppercase tracking-[0.16em] text-[#6fe28b]\" data-kid=\"1-1-2-2-2-1-1-1\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                Annotated preview\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#89988e]\" data-kid=\"1-1-2-2-2-1-1-2\">\n                                Bounding box returned in original image coordinates\n                            </p>\n                        </div>\n                        <span class=\"text-[10px] text-[#66766b]\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"annotated image filename\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            test_00005_out.png\n                        </span>\n                    </div>\n                    <div class=\"relative aspect-[16/10] overflow-hidden border border-[#3a473e] bg-[#0f1211]\" data-kid=\"1-1-2-2-2-2\">\n                        <img alt=\"Annotated dog detection preview\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"annotated preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/animal_detector/samples/test_00005_out.png\"/>\n                        <div aria-label=\"Detected dog bounding box\" class=\"absolute left-[19%] top-[17%] h-[61%] w-[57%] border-[3px] border-[#63ee84]\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"dog bounding box container\">\n                            <span class=\"absolute -top-7 left-[-3px] bg-[#63ee84] px-2 py-1 text-[11px] font-semibold text-[#102016]\" data-kid=\"1-1-2-2-2-2-2-1\" data-name=\"dog detection label\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                dog 93%\n                            </span>\n                            <span class=\"absolute -bottom-1 -right-1 h-2 w-2 bg-[#63ee84]\" data-kid=\"1-1-2-2-2-2-2-2\" data-name=\"bounding box bottom right marker\">\n                            </span>\n                            <span class=\"absolute -bottom-1 -left-1 h-2 w-2 bg-[#63ee84]\" data-kid=\"1-1-2-2-2-2-2-3\" data-name=\"bounding box bottom left marker\">\n                            </span>\n                        </div>\n                        <div class=\"absolute bottom-3 right-3 border border-[#4d6f57] bg-[#0f1711]/90 px-2 py-1 text-[10px] text-[#a9cbb0]\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"bounding box coordinates display\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            box: 42, 31, 202, 165\n                        </div>\n                    </div>\n                </div>\n                <div class=\"grid gap-5 xl:grid-cols-[1.12fr_0.88fr]\" data-kid=\"1-1-2-2-3\">\n                    <div class=\"border border-[#2a332e] bg-[#171c19] p-5\" data-kid=\"1-1-2-2-3-1\">\n                        <div class=\"flex items-center justify-between border-b border-[#2f3a33] pb-3\" data-kid=\"1-1-2-2-3-1-1\">\n                            <h2 class=\"text-sm font-semibold text-[#e4ece5]\" data-kid=\"1-1-2-2-3-1-1-1\">\n                                Model metrics\n                            </h2>\n                            <span class=\"text-[10px] text-[#74857a]\" data-kid=\"1-1-2-2-3-1-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                held-out test\n                            </span>\n                        </div>\n                        <div class=\"mt-2\" data-kid=\"1-1-2-2-3-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            <div class=\"grid grid-cols-[1fr_auto] border-b border-[#28332c] py-2.5 text-[11px] text-[#9dab9f]\" data-kid=\"1-1-2-2-3-1-2-1\">\n                                <span data-kid=\"1-1-2-2-3-1-2-1-1\">\n                                    Objectness accuracy\n                                </span>\n                                <strong class=\"font-medium text-[#7de294]\" data-kid=\"1-1-2-2-3-1-2-1-2\" data-name=\"objectness accuracy value\">\n                                    86.7%\n                                </strong>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto] border-b border-[#28332c] py-2.5 text-[11px] text-[#9dab9f]\" data-kid=\"1-1-2-2-3-1-2-2\">\n                                <span data-kid=\"1-1-2-2-3-1-2-2-1\">\n                                    Precision\n                                </span>\n                                <strong class=\"font-medium text-[#7de294]\" data-kid=\"1-1-2-2-3-1-2-2-2\" data-name=\"precision value\">\n                                    89.1%\n                                </strong>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto] border-b border-[#28332c] py-2.5 text-[11px] text-[#9dab9f]\" data-kid=\"1-1-2-2-3-1-2-3\">\n                                <span data-kid=\"1-1-2-2-3-1-2-3-1\">\n                                    Recall\n                                </span>\n                                <strong class=\"font-medium text-[#7de294]\" data-kid=\"1-1-2-2-3-1-2-3-2\" data-name=\"recall value\">\n                                    96.1%\n                                </strong>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto] border-b border-[#28332c] py-2.5 text-[11px] text-[#9dab9f]\" data-kid=\"1-1-2-2-3-1-2-4\">\n                                <span data-kid=\"1-1-2-2-3-1-2-4-1\">\n                                    Class accuracy\n                                </span>\n                                <strong class=\"font-medium text-[#7de294]\" data-kid=\"1-1-2-2-3-1-2-4-2\" data-name=\"class accuracy value\">\n                                    66.7%\n                                </strong>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto] py-2.5 text-[11px] text-[#9dab9f]\" data-kid=\"1-1-2-2-3-1-2-5\">\n                                <span data-kid=\"1-1-2-2-3-1-2-5-1\">\n                                    Mean IoU\n                                </span>\n                                <strong class=\"font-medium text-[#7de294]\" data-kid=\"1-1-2-2-3-1-2-5-2\" data-name=\"mean iou value\">\n                                    0.644\n                                </strong>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"border border-[#2a332e] bg-[#141916] p-5\" data-kid=\"1-1-2-2-3-2\">\n                        <div class=\"flex items-center justify-between border-b border-[#2f3a33] pb-3\" data-kid=\"1-1-2-2-3-2-1\">\n                            <h2 class=\"text-sm font-semibold text-[#e4ece5]\" data-kid=\"1-1-2-2-3-2-1-1\">\n                                Backend return\n                            </h2>\n                            <span class=\"text-[10px] uppercase tracking-[0.14em] text-[#6b7e71]\" data-kid=\"1-1-2-2-3-2-1-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                                dict\n                            </span>\n                        </div>\n                        <div class=\"mt-3 space-y-2.5 text-[11px]\" data-kid=\"1-1-2-2-3-2-2\" style=\"font-family:'IBM Plex Mono', monospace;\">\n                            <div class=\"flex justify-between gap-3\" data-kid=\"1-1-2-2-3-2-2-1\">\n                                <span class=\"text-[#718277]\" data-kid=\"1-1-2-2-3-2-2-1-1\">\n                                    class\n                                </span>\n                                <span class=\"text-[#d6e4d9]\" data-kid=\"1-1-2-2-3-2-2-1-2\" data-name=\"backend class name\">\n                                    \"dog\"\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between gap-3\" data-kid=\"1-1-2-2-3-2-2-2\">\n                                <span class=\"text-[#718277]\" data-kid=\"1-1-2-2-3-2-2-2-1\">\n                                    confidence\n                                </span>\n                                <span class=\"text-[#7de294]\" data-kid=\"1-1-2-2-3-2-2-2-2\" data-name=\"backend confidence value\">\n                                    0.9300\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between gap-3\" data-kid=\"1-1-2-2-3-2-2-3\">\n                                <span class=\"text-[#718277]\" data-kid=\"1-1-2-2-3-2-2-3-1\">\n                                    box\n                                </span>\n                                <span class=\"text-right text-[#d6e4d9]\" data-kid=\"1-1-2-2-3-2-2-3-2\" data-name=\"backend bounding box coordinates\">\n                   
    "var_c31a830dff28": {
      "type": "variant",
      "label": "Academic Precision Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#f8f8ff] text-[#172033] font-['DM_Sans',sans-serif]\" data-kid=\"2\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#dfe2eb] bg-white\" data-kid=\"2-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-6 py-5 lg:px-8\" data-kid=\"2-1-1\" data-name=\"header inner content wrapper\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"logo and title group\">\n                <div aria-hidden=\"true\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#1560bd] text-white\" data-kid=\"2-1-1-1-1\" data-name=\"logo container\">\n                    <i class=\"ti ti-scan text-[22px]\" data-kid=\"2-1-1-1-1-1\" data-name=\"scan icon\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"title and subtitle container\">\n                    <p class=\"font-['Inter',sans-serif] text-[15px] font-bold tracking-[-0.01em] text-[#172033]\" data-kid=\"2-1-1-1-2-1\" data-name=\"application name heading\">\n                        Animal Detection Sandbox\n                    </p>\n                    <p class=\"mt-0.5 truncate text-[12px] text-[#6e778b]\" data-kid=\"2-1-1-1-2-2\" data-name=\"model type description\">\n                        NumPy CNN Model Validation\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"status indicator container\">\n                <span class=\"hidden text-[12px] font-medium text-[#7a8395] sm:inline\" data-kid=\"2-1-1-2-1\" data-name=\"status message\">\n                    Inference workspace\n                </span>\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#bfe7cf] bg-[#f2fbf5] px-3 py-1.5 text-[12px] font-semibold text-[#217346]\" data-kid=\"2-1-1-2-2\" data-name=\"model readiness badge\">\n                    <span aria-hidden=\"true\" class=\"h-1.5 w-1.5 rounded-full bg-[#2da567]\" data-kid=\"2-1-1-2-2-1\" data-name=\"readiness indicator dot\">\n                    </span>\n                    Model ready\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1180px] px-6 py-8 lg:px-8 lg:py-10\" data-kid=\"2-2\" data-name=\"main page content container\">\n        <div class=\"mb-8 max-w-[720px]\" data-kid=\"2-2-1\" data-name=\"page intro section\">\n            <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#1560bd]\" data-kid=\"2-2-1-1\" data-name=\"page subtitle\">\n                Image inference / live result\n            </p>\n            <h1 class=\"font-['Inter',sans-serif] text-3xl font-bold tracking-[-0.04em] text-[#172033] sm:text-4xl\" data-kid=\"2-2-1-2\" data-name=\"page main heading\">\n                Inspect an image for an animal\n            </h1>\n            <p class=\"mt-3 max-w-[620px] text-[15px] leading-7 text-[#657086]\" data-kid=\"2-2-1-3\" data-name=\"page description\">\n                Upload a photo, run the trained model, and review the predicted class, confidence, and location in one clear workspace.\n            </p>\n        </div>\n        <div class=\"grid items-start gap-6 lg:grid-cols-[340px_minmax(0,1fr)]\" data-kid=\"2-2-2\" data-name=\"workspace layout grid\">\n            <aside class=\"space-y-5\" data-kid=\"2-2-2-1\" data-name=\"sidebar container\">\n                <section aria-labelledby=\"upload-heading\" class=\"border border-[#dfe2eb] bg-white p-5 shadow-[0_2px_4px_rgba(23,32,51,0.03),0_12px_28px_rgba(23,32,51,0.04)]\" data-kid=\"2-2-2-1-1\" data-name=\"upload section\">\n                    <div class=\"mb-4 flex items-start justify-between gap-3\" data-kid=\"2-2-2-1-1-1\" data-name=\"upload header area\">\n                        <div data-kid=\"2-2-2-1-1-1-1\" data-name=\"upload title group\">\n                            <p class=\"text-[11px] font-bold uppercase tracking-[0.15em] text-[#8992a4]\" data-kid=\"2-2-2-1-1-1-1-1\" data-name=\"step label\">\n                                Step 01\n                            </p>\n                            <h2 class=\"mt-1 font-['Inter',sans-serif] text-[17px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-1-1-1-2\" data-name=\"upload heading\" id=\"upload-heading\">\n                                Upload an image\n                            </h2>\n                        </div>\n                        <span class=\"inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#2c7a52]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"upload status badge\">\n                            <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-2-1-1-1-2-1\" data-name=\"checkmark icon\">\n                            </i>\n                            Ready\n                        </span>\n                    </div>\n                    <label class=\"group flex cursor-pointer flex-col items-center justify-center border-2 border-dashed border-[#b7c0d1] bg-[#fbfcff] px-5 py-7 text-center hover:border-[#1560bd] hover:bg-[#f6f9ff]\" data-kid=\"2-2-2-1-1-2\" data-name=\"file drop zone\" for=\"image-upload\">\n                        <span aria-hidden=\"true\" class=\"mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-[#eaf2ff] text-[#1560bd]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"cloud upload icon container\">\n                            <i class=\"ti ti-cloud-upload text-[23px]\" data-kid=\"2-2-2-1-1-2-1-1\" data-name=\"cloud upload icon\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#27324a]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"drop prompt\">\n                            Drop image here\n                        </span>\n                        <span class=\"mt-1 text-[12px] text-[#7b8598]\" data-kid=\"2-2-2-1-1-2-3\" data-name=\"browse prompt\">\n                            or click to browse\n                        </span>\n                        <span class=\"mt-3 text-[11px] text-[#a0a7b5]\" data-kid=\"2-2-2-1-1-2-4\" data-name=\"file format info\">\n                            PNG, JPG up to 10 MB\n                        </span>\n                    </label>\n                    <input accept=\"image/png,image/jpeg,image/webp\" aria-describedby=\"upload-hint\" class=\"sr-only\" data-kid=\"2-2-2-1-1-3\" data-name=\"image file input field\" id=\"image-upload\" type=\"file\"/>\n                    <p class=\"mt-3 flex items-start gap-2 text-[11px] leading-5 text-[#7a8395]\" data-kid=\"2-2-2-1-1-4\" data-name=\"upload hint area\" id=\"upload-hint\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle mt-0.5 text-[14px] text-[#1560bd]\" data-kid=\"2-2-2-1-1-4-1\" data-name=\"info icon\">\n                        </i>\n                        <span data-kid=\"2-2-2-1-1-4-2\" data-name=\"upload hint text\">\n                            Choose a clear image with one subject for the most reliable box.\n                        </span>\n                    </p>\n                    <div class=\"mt-5 flex items-center justify-between gap-3 border-t border-[#edf0f5] pt-4\" data-kid=\"2-2-2-1-1-5\" data-name=\"file preview bar\">\n                        <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"2-2-2-1-1-5-1\" data-name=\"file info container\">\n                            <span aria-hidden=\"true\" class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-[#f0f3f8] text-[#657086]\" data-kid=\"2-2-2-1-1-5-1-1\" data-name=\"file icon container\">\n                                <i class=\"ti ti-file-image text-[17px]\" data-kid=\"2-2-2-1-1-5-1-1-1\" data-name=\"file image icon\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"2-2-2-1-1-5-1-2\" data-name=\"filename info\">\n                                <p class=\"truncate text-[12px] font-semibold text-[#27324a]\" data-kid=\"2-2-2-1-1-5-1-2-1\" data-name=\"filename text\">\n                                    test_00005.png\n                                </p>\n                                <p class=\"text-[11px] text-[#8b94a5]\" data-kid=\"2-2-2-1-1-5-1-2-2\" data-name=\"file status text\">\n                                    Selected image\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"shrink-0 text-[11px] font-semibold text-[#1560bd] underline decoration-[#b9d0f2] underline-offset-4\" data-kid=\"2-2-2-1-1-5-2\" data-name=\"change file button\" type=\"button\">\n                            Change\n                        </button>\n                    </div>\n                    <button class=\"mt-5 flex w-full items-center justify-center gap-2 bg-[#1560bd] px-4 py-3 text-[13px] font-bold text-white shadow-[0_3px_0_#0d4488] hover:bg-[#104f9f] active:translate-y-px active:shadow-none\" data-kid=\"2-2-2-1-1-6\" data-name=\"run detection button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-player-play-filled text-[15px]\" data-kid=\"2-2-2-1-1-6-1\" data-name=\"play icon\">\n                        </i>\n                        Run detection\n                    </button>\n                    <p class=\"mt-3 text-center text-[11px] text-[#8b94a5]\" data-kid=\"2-2-2-1-1-7\" data-name=\"pipeline info text\">\n                        Uses the 64 × 64 NumPy CNN inference pipeline\n                    </p>\n                </section>\n                <section aria-labelledby=\"metrics-heading\" class=\"border border-[#dfe2eb] bg-white p-5\" data-kid=\"2-2-2-1-2\" data-name=\"metrics section\">\n                    <div class=\"mb-4 flex items-center justify-between gap-3\" data-kid=\"2-2-2-1-2-1\" data-name=\"metrics header\">\n                        <h2 class=\"font-['Inter',sans-serif] text-[15px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"metrics section heading\" id=\"metrics-heading\">\n                            Sandbox metrics\n                        </h2>\n                        <span class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#9aa2b1]\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"dataset label\">\n                            Test set\n                        </span>\n                    </div>\n                    <div class=\"divide-y divide-[#edf0f5] border-y border-[#edf0f5]\" data-kid=\"2-2-2-1-2-2\" data-name=\"metrics list\">\n                        <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"metric row 1\">\n                            <span class=\"text-[12px] text-[#687388]\" data-kid=\"2-2-2-1-2-2-1-1\" data-name=\"metric label 1\">\n                                Objectness accuracy\n                            </span>\n                            <span class=\"font-['Inter',sans-serif] text-[13px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-2-2-1-2\" data-name=\"metric value 1\">\n                                86.7%\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"metric row 2\">\n                            <span class=\"text-[12px] text-[#687388]\" data-kid=\"2-2-2-1-2-2-2-1\" data-name=\"metric label 2\">\n                                Precision / Recall\n                            </span>\n                            <span class=\"font-['Inter',sans-serif] text-[13px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-2-2-2-2\" data-name=\"metric value 2\">\n                                89.1% / 96.1%\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"2-2-2-1-2-2-3\" data-name=\"metric row 3\">\n                            <span class=\"text-[12px] text-[#687388]\" data-kid=\"2-2-2-1-2-2-3-1\" data-name=\"metric label 3\">\n                                Classification accuracy\n                            </span>\n                            <span class=\"font-['Inter',sans-serif] text-[13px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-2-2-3-2\" data-name=\"metric value 3\">\n                                66.7%\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"2-2-2-1-2-2-4\" data-name=\"metric row 4\">\n                            <span class=\"text-[12px] text-[#687388]\" data-kid=\"2-2-2-1-2-2-4-1\" data-name=\"metric label 4\">\n                                Mean IoU\n                            </span>\n                            <span class=\"font-['Inter',sans-serif] text-[13px] font-bold text-[#172033]\" data-kid=\"2-2-2-1-2-2-4-2\" data-name=\"metric value 4\">\n                                0.644\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"mt-4 text-[11px] leading-5 text-[#8b94a5]\" data-kid=\"2-2-2-1-2-3\" data-name=\"metrics footer note\">\n                        Measured on the held-out synthetic test dataset.\n                    </p>\n                </section>\n            </aside>\n            <section aria-labelledby=\"result-heading\" class=\"min-w-0 border border-[#dfe2eb] bg-white p-5 shadow-[0_2px_4px_rgba(23,32,51,0.03),0_12px_28px_rgba(23,32,51,0.04)] sm:p-6\" data-kid=\"2-2-2-2\" data-name=\"result section\">\n                <div class=\"mb-5 flex flex-wrap items-end justify-between gap-4\" data-kid=\"2-2-2-2-1\" data-name=\"result section header\">\n                    <div data-kid=\"2-2-2-2-1-1\" data-name=\"result title group\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.15em] text-[#8992a4]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"result step label\">\n                            Step 02\n                        </p>\n                        <div class=\"mt-1 flex items-center gap-3\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"result heading group\">\n                            <h2 class=\"font-['Inter',sans-serif] text-[20px] font-bold text-[#172033]\" data-kid=\"2-2-2-2-1-1-2-1\" data-name=\"result section heading\" id=\"result-heading\">\n                                Detection result\n                            </h2>\n                            <span class=\"inline-flex items-center gap-1.5 border border-[#cce6d6] bg-[#f5fcf7] px-2.5 py-1 text-[11px] font-semibold text-[#247345]\" data-kid=\"2-2-2-2-1-1-2-2\" data-name=\"result status badge\">\n                                <i class=\"ti ti-check text-[14px]\" data-kid=\"2-2-2-2-1-1-2-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Detection complete\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"text-[11px] text-[#8b94a5]\" data-kid=\"2-2-2-2-1-2\" data-name=\"result timestamp\">\n                        test_00005.png · processed just now\n                    </span>\n                </div>\n                <div aria-live=\"polite\" class=\"flex items-start gap-3 border border-[#efc4d6] border-l-4 border-l-[#d71868] bg-[#fff7fb] px-4 py-3.5\" data-kid=\"2-2-2-2-2\" data-name=\"alert banner\" role=\"status\">\n                    <i aria-hidden=\"true\" class=\"ti ti-alert-circle mt-0.5 text-[20px] text-[#d71868]\" data-kid=\"2-2-2-2-2-1\" data-name=\"alert icon\">\n                    </i>\n                    <div class=\"min-w-0\" data-kid=\"2-2-2-2-2-2\" data-name=\"alert message container\">\n                        <p class=\"text-[13px] font-bold text-[#9e174d]\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"alert title\">\n                            ALERT: dog detected!\n                        </p>\n                        <p class=\"mt-0.5 text-[12px] text-[#9a5a75]\" data-kid=\"2-2-2-2-2-2-2\" data-name=\"alert body\">\n                            Animal found with\n                            <span class=\"font-bold text-[#7d1845]\" data-kid=\"2-2-2-2-2-2-2-1\" data-name=\"confidence percentage value\">\n                                93.0%\n                            </span>\n                            objectness confidence.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-5 overflow-hidden border border-[#dfe2eb] bg-[#eef1f6]\" data-kid=\"2-2-2-2-3\" data-name=\"image preview area\">\n                    <div class=\"relative aspect-[4/3] w-full overflow-hidden\" data-kid=\"2-2-2-2-3-1\" data-name=\"annotated image container\">\n                        <img alt=\"Annotated dog detection preview\" class=\"h-full w-full object-contain\" data-kid=\"2-2-2-2-3-1-1\" data-name=\"annotated image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/animal_detector/samples/test_00005_out.png\"/>\n                        <div aria-label=\"Detected dog bounding box\" class=\"absolute left-[24%] top-[16%] h-[62%] w-[45%] border-[3px] border-[#1560bd]\" data-kid=\"2-2-2-2-3-1-2\" data-name=\"bounding box overlay\">\n                            <span class=\"absolute -top-7 left-[-3px] inline-flex items-center gap-1 bg-[#1560bd] px-2.5 py-1 text-[11px] font-bold text-white\" data-kid=\"2-2-2-2-3-1-2-1\" data-name=\"box label\">\n                                <i class=\"ti ti-paw text-[13px]\" data-kid=\"2-2-2-2-3-1-2-1-1\" data-name=\"paw icon\">\n                                </i>\n                                dog 93%\n                            </span>\n                            <span class=\"absolute -bottom-7 right-0 bg-white/90 px-2 py-1 text-[10px] font-semibold text-[#1560bd]\" data-kid=\"2-2-2-2-3-1-2-2\" data-name=\"bounding box label hint\">\n                                bounding box\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-5 grid gap-3 border-t border-[#edf0f5] pt-5 sm:grid-cols-3\" data-kid=\"2-2-2-2-4\" data-name=\"result metrics summary\">\n                    <div class=\"border-l-2 border-[#1560bd] pl-3\" data-kid=\"2-2-2-2-4-1\" data-name=\"result animal category\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#8b94a5]\" data-kid=\"2-2-2-2-4-1-1\" data-name=\"animal category label\">\n                            Animal\n                        </p>\n                        <p class=\"mt-1 font-['Inter',sans-serif] text-[15px] font-bold capitalize text-[#172033]\" data-kid=\"2-2-2-2-4-1-2\" data-name=\"animal category value\">\n                            Dog\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[#1560bd] pl-3\" data-kid=\"2-2-2-2-4-2\" data-name=\"result confidence\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#8b94a5]\" data-kid=\"2-2-2-2-4-2-1\" data-name=\"confidence label\">\n                            Confidence\n                        </p>\n                        <p class=\"mt-1 font-['Inter',sans-serif] text-[15px] font-bold text-[#172033]\" data-kid=\"2-2-2-2-4-2-2\" data-name=\"confidence value\">\n                            93.0%\n                        </p>\n                    </div>\n                    <div class=\"border-l-2 border-[#1560bd] pl-3\" data-kid=\"2-2-2-2-4-3\" data-name=\"result bounding box coords\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#8b94a5]\" data-kid=\"2-2-2-2-4-3-1\" data-name=\"bounding box label\">\n                            Bounding box\n                        </p>\n                        <p class=\"mt-1 font-['Inter',sans-serif] text-[15px] font-bold text-[#172033]\" data-kid=\"2-2-2-2-4-3-2\" data-name=\"bounding box value\">\n                            x1, y1, x2, y2\n                        </p>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#dfe2eb] pt-5 text-[11px] text-[#8992a4] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"2-2-3\" data-name=\"page footer\">\n            <span data-kid=\"2-2-3-1\" data-name=\"copyright notice\">\n                Animal Detection Sandbox · NumPy CNN showcase\n            </span>\n            <span data-kid=\"2-2-3-2\" data-name=\"classes list notice\">\n                Classes: dog · cat · bird · rabbit\n            </span>\n        </footer>\n    </main>\n</div>\n",
